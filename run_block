def prompt_yes_no_box(
    title: str,
    content_lines: list[str],
    question: str,
    default_yes: bool = False,
    yes_status: str = "✓ Confirmed by user.",
    no_status: str = "✗ Canceled by user.",
    tty_streams: tuple[object, object] | None = None,
) -> bool:
    suffix = "[Y/n]:" if default_yes else "[y/N]:"
    prompt_line = f"-> {question} {suffix}"
    box, inner_width, cursor_offset = format_prompt_box(title, content_lines, prompt_line)
    bottom = f"└─{'─' * inner_width}─┘"
    try:
        if tty_streams is not None:
            tty_w, tty_r = tty_streams
            close_after = False
        else:
            tty_w, tty_r = open_tty()
            close_after = True
        try:
            tty_w.write(f"{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_confirm_key(tty_r, default_yes=default_yes)
                if action == "yes":
                    approved = True
                    break
                if action == "no":
                    approved = False
                    break
            status_line = yes_status if approved else no_status
            tty_w.write(f"\r{pad_box_line(status_line, inner_width)}\n{bottom}\n")
            tty_w.flush()
            return approved
        finally:
            if close_after:
                tty_w.close()
                tty_r.close()
    except OSError:
        return default_yes


def resolve_editor_command() -> list[str]:
    cfg_ed, _ = get_setting("editor")
    if cfg_ed and cfg_ed.lower() != "auto":
        return shlex.split(cfg_ed)
    for env_k in ("VISUAL", "EDITOR"):
        val = os.environ.get(env_k, "").strip()
        if val:
            return shlex.split(val)
    for candidate in ("vim", "vi", "less", "nano", "more"):
        if shutil.which(candidate):
            return [candidate]
    return ["vi"]


def open_script_in_editor(script_path: Path, tty_r, tty_w) -> None:
    cmd = resolve_editor_command() + [str(script_path)]
    try:
        subprocess.run(cmd, stdin=tty_r, stdout=tty_w, stderr=tty_w, check=False)
    except Exception as exc:
        tty_w.write(f"\n[editor error: {exc}]\n")
        tty_w.flush()


def read_confirm_key(tty_r, default_yes: bool) -> str:
    """Reads a single key: returns 'yes', 'no', or 'view'."""
    flush_tty_input(tty_r)
    if not HAS_PTY or termios is None or tty is None:
        ans = tty_r.readline().strip().lower()
        if ans in ("v", "view", "e", "edit"):
            return "view"
        if default_yes and ans in ("", "y", "yes"):
            return "yes"
        if not default_yes and ans in ("y", "yes"):
            return "yes"
        if ans in ("n", "no", "q", "esc"):
            return "no"
        return "invalid"
    try:
        fd = tty_r.fileno()
        old_attrs = termios.tcgetattr(fd)
    except Exception:
        ans = tty_r.readline().strip().lower()
        return "view" if ans in ("v", "view", "e", "edit") else ("yes" if ans in ("y", "yes") else "no")
    try:
        tty.setraw(fd, termios.TCSANOW)
        while True:
            ch = os.read(fd, 1)
            if not ch:
                return "no"
            if ch in (b"v", b"V", b"e", b"E"):
                return "view"
            if ch in (b"y", b"Y"):
                return "yes"
            if default_yes and ch in (b"\r", b"\n"):
                return "yes"
            if ch in (b"n", b"N", b"q", b"Q", b"\x03", b"\x04"):
                return "no"
            if ch == b"\x1b":
                rlist, _, _ = select.select([fd], [], [], 0.05)
                if rlist:
                    os.read(fd, 32)
                    continue
                return "no"
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        except Exception:
            pass


def confirm_execution(
    label: str,
    script_text: str,
    summary: dict[str, object] | None = None,
    script_path: Path | None = None,
    auto_yes: bool = False,
) -> tuple[bool, str]:
    if in_run_block():
        return True, ""
    findings = scan_script_risks(script_text)
    note = ""
    approve_decision = ""
    approve_cmd, _ = get_setting("approve_cmd")
    if approve_cmd:
        wdir = Path(str(summary.get("work_dir"))) if summary and summary.get("work_dir") else get_work_dir()
        plan_obj = analyze_script(script_text, work_dir=wdir, label=label, check_syntax=False)
        approve_decision, note = run_approve_cmd(approve_cmd, label, script_text, plan_obj, script_path=script_path)
        if approve_decision == "reject":
            return False, (note or "rejected by RUN_BLOCK_APPROVE_CMD")
        if approve_decision == "approve":
            if findings and (auto_yes or not sys.stdout.isatty() or no_clipboard()):
                for f in findings:
                    sys.stdout.write(f"[{label}] safety warning [{f['category']}]: {f['snippet']}\n")
                sys.stdout.flush()
            return True, note
    if auto_yes or not sys.stdout.isatty() or no_clipboard():
        if findings:
            for f in findings:
                sys.stdout.write(f"[{label}] safety warning [{f['category']}]: {f['snippet']}\n")
            sys.stdout.flush()
        return True, note
    default_yes = (len(findings) == 0 and approve_decision != "prompt")
    box, inner_width, cursor_offset = format_safety_box(
        label, findings, default_yes=default_yes, summary=summary, note=note
    )
    bottom = f"└─{'─' * inner_width}─┘"
    prompt_suffix = "[Y/n/v(iew)]:" if default_yes else "[y/n/v(iew)]:"
    prompt_line = f"-> Execute this block? {prompt_suffix}"
    try:
        tty_w, tty_r = open_tty()
        with tty_w, tty_r:
            tty_w.write(f"{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_confirm_key(tty_r, default_yes=default_yes)
                if action == "view":
                    if script_path is not None and script_path.is_file():
                        open_script_in_editor(script_path, tty_r, tty_w)
                        p_offset = 2 + display_width(prompt_line)
                        tty_w.write(f"\r{pad_box_line(prompt_line, inner_width)}\n{bottom}\r\033[1A\033[{p_offset}C")
                        tty_w.flush()
                    continue
                if action == "yes":
                    approved = True
                    break
                if action == "no":
                    approved = False
                    break
            run_target = str(script_path) if script_path is not None else label
            status_line = f"✓ Running {run_target} ..." if approved else f"✗ Aborted (--retry {label})"
            tty_w.write(f"\r{pad_box_line(status_line, inner_width)}\n{bottom}\n")
            tty_w.flush()
            return approved, ("" if approved else "USER_ABORTED")
    except OSError:
        return True, note


# --- Built-in token and byte statistics ---
_ENC = None
_ENC_TRIED = False


def gpt_encoder():
    global _ENC, _ENC_TRIED
    if not _ENC_TRIED:
        _ENC_TRIED = True
        try:
            import tiktoken  # type: ignore[import-not-found]
            _ENC = tiktoken.get_encoding("o200k_base")
        except Exception:
            _ENC = None
    return _ENC


def count_tokens(data: bytes) -> dict[str, int | bool]:
    text = data.decode("utf-8", "replace")
    chars = len(text)
    lines = text.count("\n") + (1 if text and not text.endswith("\n") else 0)
    enc = gpt_encoder()
    if enc is not None:
        gpt = len(enc.encode(text, disallowed_special=()))
    else:
        gpt = math.ceil(chars / 4)
    return {
        "bytes": len(data),
        "lines": lines,
        "claude": math.ceil(chars / 3.5),
        "gpt": gpt,
        "gpt_exact": enc is not None,
        "gemini": math.ceil(chars / 4),
    }


def _human_size(num_bytes: int) -> str:
    if num_bytes < 1024:
        return f"{num_bytes} B"
    return f"{num_bytes / 1024:.1f} KB"


def _human_tok(n: int) -> str:
    if n < 1000:
        return f"{n}"
    return f"{n / 1000:.1f}k"


def format_stats(data: bytes) -> str:
    s = count_tokens(data)
    lines = int(s["lines"])
    sz = _human_size(int(s["bytes"]))
    lo = min(int(s["gpt"]), int(s["claude"]))
    hi = max(int(s["gpt"]), int(s["claude"]))
    tok_str = f"~{_human_tok(lo)}–{_human_tok(hi)} tokens" if lo != hi else f"~{_human_tok(lo)} tokens"
    line_lbl = f"{lines} line{'s' if lines != 1 else ''}"
    return f"{line_lbl} · {sz} · {tok_str}"


def stats_line(path: Path) -> str | None:
    enabled, _ = get_setting("token_stats")
    if enabled == "false":
        return None
    try:
        return format_stats(path.read_bytes())
    except Exception:
        return None


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
CR_LINE_RE = re.compile(r"[^\n]*\r(?!\n)")


def resolve_clipboard_target(out_path: Path, full_output: str) -> Path:
    matches = re.findall(
        r"^(?:\[[A-Za-z0-9._-]+\] Attach:|│?\s*Bundle:)\s*(\S+?)\s*(?:│)?$",
        full_output,
        flags=re.MULTILINE,
    )
    if matches:
        candidate = Path(matches[-1])
        if candidate.is_file():
            return candidate
    return out_path


def clipboard_command(out_path: Path) -> tuple[list[str], str] | None:
    if shutil.which("xclip") and os.environ.get("DISPLAY"):
        return ["xclip", "-selection", "clipboard"], f"xclip -selection clipboard < {out_path}"
    if shutil.which("wl-copy") and os.environ.get("WAYLAND_DISPLAY"):
        return ["wl-copy"], f"wl-copy < {out_path}"
    if shutil.which("pbcopy"):
        return ["pbcopy"], f"pbcopy < {out_path}"
    if shutil.which("xsel") and os.environ.get("DISPLAY"):
        return ["xsel", "--clipboard", "--input"], f"xsel --clipboard --input < {out_path}"
    if shutil.which("clip.exe"):
        return ["clip.exe"], f"clip.exe < {out_path}"
    return None


def copy_file_to_clipboard(cmd: list[str], out_path: Path) -> bool:
    try:
        with open(out_path, "rb") as f_in:
            r = subprocess.run(
                cmd,
                stdin=f_in,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            )
        return r.returncode == 0
    except Exception:
        return False


def display_width(text: str) -> int:
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in text)


def pad_box_line(text: str, inner_width: int) -> str:
    pad = max(0, inner_width - display_width(text))
    return f"│ {text}{' ' * pad} │"


def build_box_body_lines(
    out_path: Path,
    rc: int | None = None,
    stats: str | None = None,
    extra_lines: list[str] | None = None,
) -> list[str]:
    if extra_lines is not None:
        body_lines = list(extra_lines)
    else:
        body_lines = []
        if rc is not None and rc != 0:
            body_lines.append(f"Exit: {rc}")
        body_lines.append(f"Output: {out_path}")
    if stats and not any(line.startswith("Stats:") for line in body_lines):
        body_lines.append(f"Stats: {stats}")
    return body_lines


def format_clipboard_box(
    label: str,
    out_path: Path,
    ok: bool = True,
    rc: int | None = None,
    stats: str | None = None,
    title_kind: str = "END",
    extra_lines: list[str] | None = None,
) -> tuple[str, int, int]:
    title = f" {label} · {title_kind} "
    body_lines = build_box_body_lines(out_path, rc=rc, stats=stats, extra_lines=extra_lines)
    prompt_line = "-> Copy to clipboard? [Enter/v(iew)/Esc]:"
    copied_line = f"✓ Copied {out_path} to clipboard."
    inner_width = max(
        display_width(title),
        display_width(prompt_line),
        display_width(copied_line),
        *(display_width(b) for b in body_lines),
    )
    dashes = max(1, inner_width + 2 - display_width(title) - 1)
    top = f"┌─{title}{'─' * dashes}┐"
    bottom = f"└─{'─' * inner_width}─┘"
    rows = [pad_box_line(b, inner_width) for b in body_lines]
    rows.append(pad_box_line("", inner_width))
    rows.append(pad_box_line(prompt_line, inner_width))
    box = "\n".join([top, *rows, bottom])
    cursor_col_offset = 2 + display_width(prompt_line)
    return box, inner_width, cursor_col_offset


def offer_clipboard_copy(
    label: str,
    out_path: Path,
    ok: bool = True,
    rc: int | None = None,
    title_kind: str = "END",
    extra_lines: list[str] | None = None,
) -> None:
    if in_run_block():
        return
    mode = clipboard_mode()
    if mode == "never":
        return
    clip = clipboard_command(out_path)
    if clip is None:
        return
    cmd, cmd_str = clip
    if mode == "auto":
        if copy_file_to_clipboard(cmd, out_path):
            sys.stdout.write(f"✓ Copied {out_path} to clipboard.\n")
        else:
            sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    if not sys.stdout.isatty():
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    box, inner_width, cursor_offset = format_clipboard_box(
        label, out_path, ok=ok, rc=rc, stats=stats_line(out_path), title_kind=title_kind, extra_lines=extra_lines
    )
    bottom = f"└─{'─' * inner_width}─┘"
    line2 = "-> Copy to clipboard? [Enter/v(iew)/Esc]:"
    try:
        tty_w, tty_r = open_tty()
        with tty_w, tty_r:
            tty_w.write(f"\n{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_clipboard_key(tty_r)
                if action == "view":
                    if out_path.is_file():
                        open_script_in_editor(out_path, tty_r, tty_w)
                        tty_w.write(f"\r{pad_box_line(line2, inner_width)}\n{bottom}\r\033[1A\033[{cursor_offset}C")
                        tty_w.flush()
                    continue
                if action == "copy":
                    if copy_file_to_clipboard(cmd, out_path):
                        status_line = f"✓ Copied {out_path} to clipboard."
                    else:
                        status_line = f"✗ Clipboard copy failed; run: {cmd_str}"
                else:
                    status_line = "Skipped clipboard copy."
                break
            tty_w.write(f"\r{pad_box_line(status_line, inner_width)}\n{bottom}\n")
            tty_w.flush()
    except OSError:
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()


def ensure_base() -> Path:
    BASE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        BASE_DIR.chmod(0o700)
    except OSError:
        pass
    return BASE_DIR


def next_session_name(base: Path) -> str:
    used = set()
    for p in base.iterdir():
        m = re.fullmatch(r"s(\d+)", p.name)
        if m:
            used.add(int(m.group(1)))
    n = 1
    while n in used:
        n += 1
    return f"s{n}"


def start_session(name: str | None = None, force: bool = False, sandbox_mode: str | None = None) -> Path:
    base = ensure_base()
    if not name:
        name = next_session_name(base)
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        raise SystemExit(f"{prog_name()}: invalid session name: {name!r}")
    sdir = base / name
    if sdir.exists():
        if not force:
            if not sys.stdin.isatty():
                raise SystemExit(f"{prog_name()}: session {sdir} already exists (use --force to overwrite)")
            if sys.stdout.isatty() and not no_clipboard():
                ok = prompt_yes_no_box(
                    f"{name} · SESSION ALREADY EXISTS",
                    [f"Directory: {sdir}"],
                    f"Overwrite session {name}?",
                    default_yes=False,
                    yes_status=f"✓ Overwriting session {name}.",
                    no_status=f"✗ Aborted overwriting session {name}.",
                )
                if not ok:
                    raise SystemExit(f"{prog_name()}: aborted")
            else:
                sys.stderr.write(f"Session {sdir} already exists. Overwrite? [y/N] ")
                sys.stderr.flush()
                ans = sys.stdin.readline().strip().lower()
                if ans not in ("y", "yes"):
                    raise SystemExit(f"{prog_name()}: aborted")
        shutil.rmtree(sdir)
    sdir.mkdir(mode=0o700, parents=True)
    ensure_session_bundle(sdir, sandbox_mode=sandbox_mode)
    return sdir


def parse_ref(ref: str, allow_fix_step: bool) -> tuple[str, str]:
    pattern = r"^([A-Za-z0-9._-]+)/(\d+(?:_\d+)?)$" if allow_fix_step else r"^([A-Za-z0-9._-]+)/(\d+)$"
    m = re.fullmatch(pattern, ref.strip())
    if not m:
        kind = "<session>/<step> (e.g. s1/2 or s1/2_1)" if allow_fix_step else "<session>/<step> (e.g. s1/1)"
        raise SystemExit(f"{prog_name()}: invalid block reference {ref!r}; expected {kind}")
    return m.group(1), m.group(2)


def next_fix_step(step: str) -> str:
    if "_" in step:
        base, sub = step.split("_", 1)
        return f"{base}_{int(sub) + 1}"
    return f"{step}_1"


def write_private(path: Path, content: str, overwrite: bool = False) -> None:
    flags = os.O_WRONLY | os.O_CREAT | (os.O_TRUNC if overwrite else os.O_EXCL)
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)


def not_run_exit(
    label: str, sdir: Path, step_name: str, out_path: Path, msg: str, rc: int = 2, headless: bool = False
) -> int:
    sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
    line = msg if msg.endswith("\n") else msg + "\n"
    clean_msg = msg.strip()
    prefix = f"[{label}] NOT RUN:"
    detail = clean_msg[len(prefix):].strip() if clean_msg.startswith(prefix) else clean_msg
    err_target = sdir / f"{step_name}.error.txt" if out_path.exists() else out_path
    try:
        write_private(err_target, line, overwrite=True)
    except Exception:
        pass
    is_headless = headless or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    if is_headless:
        sys.stdout.write(line)
        sys.stdout.flush()
        return rc
    body_lines = [
        f"Reason: {detail}",
        f"Output: {err_target}",
    ]
    can_prompt_clip = (
        not in_run_block()
        and sys.stdout.isatty()
        and clipboard_mode() == "prompt"
        and clipboard_command(err_target) is not None
    )
    if can_prompt_clip:
        offer_clipboard_copy(label, err_target, ok=False, rc=rc, title_kind="NOT RUN", extra_lines=body_lines)
    else:
        full_body = build_box_body_lines(err_target, rc=rc, stats=stats_line(err_target), extra_lines=body_lines)
        sys.stdout.write(format_info_box(f"{label} · NOT RUN", full_body) + "\n")
        sys.stdout.flush()
        if not in_run_block():
            offer_clipboard_copy(label, err_target, ok=False, rc=rc, title_kind="NOT RUN", extra_lines=body_lines)
    return rc


def run_script(
    label: str,
    script_path: Path,
    out_path: Path,
    header_lines: list[str] | None = None,
    cleanup_on_abort: list[Path] | None = None,
    auto_yes: bool = False,
    sandbox_override: str | None = None,
) -> int:
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    sdir = script_path.parent
    work_dir = get_work_dir(sdir)
    sandbox_mode = get_sandbox_mode(sdir, override=sandbox_override)
    shell_bin, _ = get_setting("shell")
    is_ps = _is_powershell(shell_bin)
    script_text = script_path.read_text(encoding="utf-8")

    if is_ps:
        ps_check = (
            "$err = $null; "
            "[void][System.Management.Automation.Language.Parser]::ParseFile($args[0], [ref]$null, [ref]$err); "
            "if ($err) { foreach ($e in $err) { [Console]::Error.WriteLine($e.ToString()) }; exit 1 }"
        )
        chk_cmd = [shell_bin, "-NoProfile", "-NonInteractive", "-Command", ps_check, str(script_path)]
        exec_cmd = [shell_bin, "-NoProfile", "-File", str(script_path)]
    else:
        chk_cmd = [shell_bin, "-n", str(script_path)]
        exec_cmd = [shell_bin, str(script_path)]

    chk = subprocess.run(
        chk_cmd,
        cwd=work_dir,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if chk.returncode != 0:
        start_line = f"[{label}] START\n\n"
        msg = chk.stdout or "syntax check failed\n"
        end_line = f"[{label}] END (syntax error, exit {chk.returncode})\n"
        full_output = start_line + msg + end_line
        write_private(out_path, full_output)
        if headless:
            sys.stdout.write(full_output)
            sys.stdout.flush()
            return chk.returncode
        err_lines = msg.rstrip("\n").splitlines() or ["syntax check failed"]
        box_lines = [
            f"Exit: {chk.returncode}",
            f"Script: {script_path}",
            f"Output: {out_path}",
            f"Error: {err_lines[0]}",
            *(f"  {eline}" for eline in err_lines[1:]),
        ]
        can_prompt_clip = (
            not in_run_block()
            and sys.stdout.isatty()
            and clipboard_mode() == "prompt"
            and clipboard_command(out_path) is not None
        )
        if can_prompt_clip:
            offer_clipboard_copy(label, out_path, ok=False, rc=chk.returncode, title_kind="SYNTAX ERROR", extra_lines=box_lines)
        else:
            full_body = build_box_body_lines(out_path, rc=chk.returncode, stats=stats_line(out_path), extra_lines=box_lines)
            sys.stdout.write(format_info_box(f"{label} · SYNTAX ERROR", full_body) + "\n")
            sys.stdout.flush()
            if not in_run_block():
                offer_clipboard_copy(label, out_path, ok=False, rc=chk.returncode, title_kind="SYNTAX ERROR", extra_lines=box_lines)
        return chk.returncode

    aborted_marker = script_path.with_suffix(".aborted")
    summary_obj = summarize_script_actions(script_text, work_dir=work_dir)
    summary_obj["sandbox"] = sandbox_mode
    approved, abort_reason = confirm_execution(
        label, script_text, summary=summary_obj, script_path=script_path, auto_yes=headless
    )
    if not approved:
        write_private(aborted_marker, "aborted\n", overwrite=True)
        if abort_reason == "USER_ABORTED":
            return 130
        reason_str = abort_reason or f"aborted by user (re-run with: {prog_name()} --retry {label})"
        return not_run_exit(
            label, script_path.parent, script_path.stem, out_path, f"[{label}] NOT RUN: {reason_str}", rc=130, headless=headless
        )
    aborted_marker.unlink(missing_ok=True)

    start_line = f"[{label}] START\n"
    log_chunks: list[str] = [start_line]
    for h in header_lines or []:
        log_chunks.append(h)
    log_chunks.append("\n")
    if headless:
        sys.stdout.write("".join(log_chunks))
    elif header_lines:
        sys.stdout.write("".join(header_lines) + "\n")
    sys.stdout.flush()

    tty_in = None
    master_fd = None
    slave_fd = None
    if HAS_PTY and sys.stdout.isatty() and not no_clipboard() and not headless:
        try:
            tty_in = open("/dev/tty", "rb", buffering=0)
            master_fd, slave_fd = pty.openpty()
            attrs = termios.tcgetattr(slave_fd)
            attrs[1] &= ~termios.ONLCR
            termios.tcsetattr(slave_fd, termios.TCSANOW, attrs)
        except OSError:
            if tty_in is not None:
                tty_in.close()
                tty_in = None
            if master_fd is not None:
                os.close(master_fd)
                master_fd = None
            if slave_fd is not None:
                os.close(slave_fd)
                slave_fd = None

    bundle_file = sdir / "0.txt"
    bundle_snapshot = bundle_file.read_bytes() if bundle_file.is_file() else None
    child_env = scrub_child_env({**os.environ, "IN_RUN_BLOCK": "1"}, sandbox_mode)
    exec_cmd = build_sandbox_exec(exec_cmd, work_dir=work_dir, base_dir=ensure_base(), sandbox_mode=sandbox_mode)
    if master_fd is not None and slave_fd is not None:
        try:
            proc = subprocess.Popen(
                exec_cmd,
                cwd=work_dir,
                stdin=tty_in if tty_in is not None else slave_fd,
                stdout=slave_fd,
                stderr=slave_fd,
                env=child_env,
                close_fds=True,
            )
            os.close(slave_fd)
            slave_fd = None
            while True:
                try:
                    chunk = os.read(master_fd, 4096)
                except OSError:
                    break
                if not chunk:
                    break
                text = chunk.decode("utf-8", "replace")
                log_chunks.append(text)
                sys.stdout.write(text)
                sys.stdout.flush()
            rc = proc.wait()
        finally:
            if slave_fd is not None:
                os.close(slave_fd)
            if master_fd is not None:
                os.close(master_fd)
            if tty_in is not None:
                tty_in.close()
    else:
        proc = subprocess.Popen(
            exec_cmd,
            cwd=work_dir,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=child_env,
        )
        assert proc.stdout is not None
        while True:
            chunk = proc.stdout.read1(4096) if hasattr(proc.stdout, "read1") else proc.stdout.read(4096)
            if not chunk:
                break
            text = chunk.decode("utf-8", "replace")
            log_chunks.append(text)
            sys.stdout.write(text)
            sys.stdout.flush()
        proc.stdout.close()
        rc = proc.wait()
    if bundle_snapshot is not None:
        if not bundle_file.is_file() or bundle_file.read_bytes() != bundle_snapshot:
            write_private(bundle_file, bundle_snapshot.decode("utf-8", "replace"), overwrite=True)
            warn_msg = f"\n[{label}] SECURITY WARNING: block attempted to modify {bundle_file.name} (reverted)\n"
            log_chunks.append(warn_msg)
            sys.stdout.write(warn_msg)
            sys.stdout.flush()
    if log_chunks and not log_chunks[-1].endswith("\n"):
        log_chunks.append("\n")
        sys.stdout.write("\n")
    exit_str = f" (exit {rc})" if rc != 0 else ""
    end_line = f"\n[{label}] END{exit_str}\n"
    log_chunks.append(end_line)
    full_output = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(log_chunks))).replace("\r\n", "\n")
    write_private(out_path, full_output)
    clip_target = resolve_clipboard_target(out_path, full_output)
    if headless:
        sys.stdout.write(end_line)
        sys.stdout.flush()
    elif in_run_block() or not sys.stdout.isatty() or clipboard_mode() != "prompt" or clipboard_command(clip_target) is None:
        end_body = build_box_body_lines(clip_target, rc=rc, stats=stats_line(clip_target))
        sys.stdout.write("\n" + format_info_box(f"{label} · END", end_body) + "\n")
        sys.stdout.flush()
    if not headless:
        offer_clipboard_copy(label, clip_target, ok=(rc == 0), rc=rc)
    return rc


def cmd_normal(
    ref: str, payload: str, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    session, step = parse_ref(ref, allow_fix_step=False)
    step_num = int(step)
    if step_num < 1:
        raise SystemExit(f"{prog_name()}: step number must be >= 1")
    sdir = ensure_base() / session
    sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
    ensure_session_bundle(sdir, sandbox_mode=sandbox_override)
    label = f"{session}/{step}"
    script_path = _find_step_script(sdir, step)
    out_path = sdir / f"{step}.txt"

    aborted_marker = script_path.with_suffix(".aborted")
    overwrite = aborted_marker.exists()
    if overwrite:
        out_path.unlink(missing_ok=True)
        aborted_marker.unlink(missing_ok=True)
    elif script_path.exists() or out_path.exists():
        if sys.stdout.isatty() and not no_clipboard() and not headless:
            existing_lines = [f"Script: {script_path}"]
            if out_path.exists():
                existing_lines.append(f"Output: {out_path}")
            if prompt_yes_no_box(
                f"{label} · STEP ALREADY EXISTS",
                existing_lines,
                f"Overwrite and re-run {label}?",
                default_yes=False,
                yes_status=f"✓ Overwriting {label}.",
                no_status=f"✗ Keeping existing {label}.",
            ):
                overwrite = True
                out_path.unlink(missing_ok=True)
            else:
                return 2
        if not overwrite:
            return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: step already exists — output: {out_path}", headless=headless)
    if step_num > 1 and not _find_step_script(sdir, str(step_num - 1)).exists():
        prev_label = f"{session}/{step_num - 1}"
        allow_skip = False
        if sys.stdout.isatty() and not no_clipboard() and not headless:
            allow_skip = prompt_yes_no_box(
                f"{label} · MISSING PREVIOUS STEP",
                [f"Missing: {prev_label}"],
                f"Run {label} anyway?",
                default_yes=False,
                yes_status=f"✓ Proceeding with {label} (skipped {prev_label}).",
                no_status=f"✗ Canceled {label} (run {prev_label} first).",
            )
            if not allow_skip:
                return 2
        if not allow_skip:
            return not_run_exit(
                label,
                sdir,
                step,
                out_path,
                f"[{label}] NOT RUN: previous step {prev_label} has not been run yet",
                headless=headless,
            )
    if not payload.strip():
        return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: empty script on stdin", headless=headless)

    write_private(script_path, payload, overwrite=overwrite)
    return run_script(
        label,
        script_path,
        out_path,
        cleanup_on_abort=[script_path],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
    )


def cmd_fix(
    ref: str, fix_code: str, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    headless = auto_yes or os.environ.get("RUN_BLOCK_HEADLESS") == "1"
    session, target = parse_ref(ref, allow_fix_step=True)
    sdir = ensure_base() / session
    src_script = _find_step_script(sdir, target)
    ext = src_script.suffix or _script_ext()
    new_step = next_fix_step(target)
    label = f"{session}/{new_step}"
    fix_path = sdir / f"{new_step}.fix"
    script_path = sdir / f"{new_step}{ext}"
    out_path = sdir / f"{new_step}.txt"

    if not src_script.exists():
        return not_run_exit(
            f"{session}/{target}",
            sdir,
            new_step,
            out_path,
            f"[{session}/{target}] NOT RUN: target script {src_script} does not exist",
        )

    if script_path.exists() or fix_path.exists():
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: fix step already exists — output: {out_path}")
    out_path.unlink(missing_ok=True)
    if not fix_code.strip():
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: empty fix on stdin")

    ast_ok, ast_err = validate_fix_ast(fix_code)
    if not ast_ok:
        return not_run_exit(
            label,
            sdir,
            new_step,
            out_path,
            f"[{label}] NOT RUN: unsafe construct in --fix ({ast_err})",
            headless=headless,
        )
    orig_text = src_script.read_text(encoding="utf-8")
    ns: dict[str, object] = {"__builtins__": dict(SAFE_FIX_BUILTINS), "text": orig_text, "re": re}
    try:
        exec(compile(fix_code, str(fix_path), "exec"), ns)
    except Exception as exc:
        return not_run_exit(
            label,
            sdir,
            new_step,
            out_path,
            f"[{label}] NOT RUN: fix raised {type(exc).__name__}: {exc}",
            headless=headless,
        )

    new_text = ns.get("text")
    if not isinstance(new_text, str):
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: fix did not leave a string in 'text'")
    if new_text == orig_text:
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: fix made no changes to {src_script}")

    write_private(fix_path, fix_code)
    write_private(script_path, new_text)
    diff = "".join(
        difflib.unified_diff(
            orig_text.splitlines(keepends=True),
            new_text.splitlines(keepends=True),
            fromfile=f"{target}{ext}",
            tofile=f"{new_step}{ext}",
        )
    )
    header = [f"[{label}] patched {target}{ext} -> {new_step}{ext}:\n", diff]
    return run_script(
        label,
        script_path,
        out_path,
        header_lines=header,
        cleanup_on_abort=[fix_path, script_path],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
    )


def _step_sort_key(stem: str) -> tuple[int, int]:
    if "_" in stem:
        b, s = stem.split("_", 1)
        return (int(b) if b.isdigit() else 0, int(s) if s.isdigit() else 0)
    return (int(stem) if stem.isdigit() else 0, 0)


def _step_status(sdir: Path, stem: str) -> str:
    if (sdir / f"{stem}.aborted").exists():
        return "ABORTED"
    out_p = sdir / f"{stem}.txt"
    if out_p.is_file():
        txt = out_p.read_text(encoding="utf-8", errors="replace")
        label = f"{sdir.name}/{stem}"
        matches = re.findall(rf"^\[{re.escape(label)}\]\s+(END|SUCCESS|FAILED|NOT RUN)([^\n]*)", txt, flags=re.MULTILINE)
        if matches:
            kind, rest = matches[-1]
            return (kind + rest.split("—")[0]).strip()
        return "DONE"
    return "SAVED"


def _find_latest_step(session: str | None = None) -> tuple[str, str]:
    base = ensure_base()
    if session:
        sdirs = [base / session] if (base / session).is_dir() else []
    else:
        sdirs = sorted(
            [p for p in base.iterdir() if p.is_dir()],
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
    for sdir in sdirs:
        scripts = [p.stem for p in _iter_session_scripts(sdir)]
        if scripts:
            return sdir.name, scripts[-1]
    raise SystemExit(f"{prog_name()}: no saved blocks found in {base}")


def cmd_list(session: str | None = None) -> int:
    base = ensure_base()
    if not session:
        sdirs = sorted([p for p in base.iterdir() if p.is_dir()], key=lambda p: p.stat().st_mtime)
        if not sdirs:
            sys.stdout.write(f"No sessions in {base}\n")
            return 0
        sys.stdout.write(f"Sessions in {base}:\n")
        for sdir in sdirs:
            scripts = [p.stem for p in _iter_session_scripts(sdir)]
            has_bundle = (sdir / "0.txt").is_file()
            if scripts:
                last = f"{sdir.name}/{scripts[-1]} ({_step_status(sdir, scripts[-1])})"
            elif has_bundle:
                last = f"{sdir.name}/0 (BUNDLE)"
            else:
                last = "empty"
            sys.stdout.write(f"  {sdir.name:<8}  {len(scripts):>3} block(s)   last: {last}\n")
        session = sdirs[-1].name
        sys.stdout.write(f"\nRecent blocks in {session}:\n")
    else:
        sdir = base / session
        if not sdir.is_dir():
            raise SystemExit(f"{prog_name()}: session {session!r} not found in {base}")
        sys.stdout.write(f"Blocks in {session}:\n")
    sdir = base / session
    if (sdir / "0.txt").is_file():
        ref0 = f"{session}/0"
        sys.stdout.write(f"  {ref0:<10}  {'BUNDLE':<24}  Session context bundle (0.txt)\n")
    script_paths = _iter_session_scripts(sdir)
    for sp in script_paths[-15:]:
        stem = sp.stem
        st = _step_status(sdir, stem)
        sh_text = sp.read_text(encoding="utf-8", errors="replace")
        summary = summarize_script_actions(sh_text, work_dir=get_work_dir(sdir))
        rows = summary.get("rows") or []
        desc = "; ".join(f"{k}: {v}" for k, v in rows[:2]) if rows else ""
        if len(desc) > 56:
            desc = desc[:53] + "..."
        ref = f"{session}/{stem}"
        sys.stdout.write(f"  {ref:<10}  {st:<24}  {desc}\n")
    return 0


def cmd_show(ref: str | None = None) -> int:
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = _find_latest_step()
    sdir = ensure_base() / session
    script_path = _find_step_script(sdir, step)
    out_path = sdir / f"{step}.txt"
    if step == "0" and out_path.is_file():
        sys.stdout.write(f"=== [{session}/0] Bundle: {out_path} ===\n")
        sys.stdout.write(out_path.read_text(encoding="utf-8", errors="replace"))
        return 0
    if not script_path.is_file():
        raise SystemExit(f"{prog_name()}: block {session}/{step} not found ({script_path})")
    sys.stdout.write(f"=== [{session}/{step}] Script: {script_path} ({_step_status(sdir, step)}) ===\n")
    sys.stdout.write(script_path.read_text(encoding="utf-8", errors="replace"))
    if out_path.is_file():
        sys.stdout.write(f"\n=== [{session}/{step}] Output: {out_path} ===\n")
        sys.stdout.write(out_path.read_text(encoding="utf-8", errors="replace"))
    return 0


def cmd_retry(
    ref: str | None = None, auto_yes: bool = False, sandbox_override: str | None = None
) -> int:
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = _find_latest_step()
    sdir = ensure_base() / session
    script_path = _find_step_script(sdir, step)
    out_path = sdir / f"{step}.txt"
    if not script_path.is_file():
        raise SystemExit(f"{prog_name()}: block {session}/{step} not found ({script_path})")
    out_path.unlink(missing_ok=True)
    (sdir / f"{step}.aborted").unlink(missing_ok=True)
    return run_script(
        f"{session}/{step}",
        script_path,
        out_path,
        cleanup_on_abort=[],
        auto_yes=auto_yes,
        sandbox_override=sandbox_override,
    )


def _find_latest_session_dir() -> Path | None:
    base = ensure_base()
    sdirs = sorted(
        [p for p in base.iterdir() if p.is_dir()],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    return sdirs[0] if sdirs else None


def cmd_sandbox(argv: list[str]) -> int:
    prog = prog_name()
    if in_run_block():
        sys.stderr.write(f"{prog}: cannot modify session sandbox settings from inside a running block\n")
        return 2
    mode_arg: str | None = None
    session_arg: str | None = None
    for a in argv:
        if re.fullmatch(r"s\d+", a) and session_arg is None and mode_arg is not None:
            session_arg = a
        elif mode_arg is None and a.lower() in ("off", "0", "false", "on", "1", "true", "auto", "strict", "nonet", "no-net"):
            mode_arg = normalize_sandbox_mode(a)
        elif session_arg is None and re.fullmatch(r"[A-Za-z0-9._-]+", a) and (ensure_base() / a).is_dir():
            session_arg = a
        elif mode_arg is None:
            mode_arg = normalize_sandbox_mode(a)
        else:
            raise SystemExit(f"{prog}: usage: {prog} --sandbox [off|strict|nonet] [session]")

    base = ensure_base()
    sdir = (base / session_arg) if session_arg else _find_latest_session_dir()
    backend = detect_sandbox_backend()
    if mode_arg is None:
        cur_mode = get_sandbox_mode(sdir)
        sess_lbl = sdir.name if sdir is not None else "(no active session)"
        sys.stdout.write(
            f"Session: {sess_lbl}\n"
            f"Sandbox: {format_sandbox_header(cur_mode)}\n"
            f"Backend: {backend}\n"
        )
        return 0
    if sdir is None:
        sdir = start_session(session_arg, sandbox_mode=mode_arg)
    else:
        sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
        set_session_bundle_header(sdir, "Sandbox", format_sandbox_header(mode_arg))
    sys.stdout.write(
        f"Updated {sdir.name}/0.txt -> Sandbox: {format_sandbox_header(mode_arg)} (backend: {backend})\n"
    )
    return 0


def _dir_size_bytes(path: Path) -> int:
    total = 0
    try:
        for p in path.rglob("*"):
            if p.is_file():
                try:
                    total += p.stat().st_size
                except OSError:
                    pass
    except OSError:
        pass
    return total


def cmd_clean(argv: list[str]) -> int:
    prog = prog_name()
    keep = 5
    clean_all = False
    yes = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--all":
            clean_all = True
            keep = 0
            i += 1
        elif a in ("-y", "--yes", "--force"):
            yes = True
            i += 1
        elif a == "--keep":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --keep requires a non-negative integer")
            try:
                keep = int(argv[i + 1])
            except ValueError:
                raise SystemExit(f"{prog}: invalid --keep value: {argv[i + 1]!r}")
            if keep < 0:
                raise SystemExit(f"{prog}: --keep must be >= 0")
            i += 2
        elif a.startswith("--keep="):
            val_s = a.split("=", 1)[1]
            try:
                keep = int(val_s)
            except ValueError:
                raise SystemExit(f"{prog}: invalid --keep value: {val_s!r}")
            if keep < 0:
                raise SystemExit(f"{prog}: --keep must be >= 0")
            i += 1
        else:
            raise SystemExit(f"{prog}: usage: {prog} --clean [--keep N | --all] [--yes]")

    base = ensure_base()
    sdirs = sorted(
        [p for p in base.iterdir() if p.is_dir()],
        key=lambda p: (p.stat().st_mtime, p.name),
    )
    if clean_all or keep == 0:
        to_remove = sdirs
    elif len(sdirs) > keep:
        to_remove = sdirs[: len(sdirs) - keep]
    else:
        to_remove = []

    if not to_remove:
        sys.stdout.write(f"Nothing to clean in {base} ({len(sdirs)} session(s) kept).\n")
        return 0

    freed_bytes = sum(_dir_size_bytes(d) for d in to_remove)
    names = ", ".join(d.name for d in to_remove)
    if not yes and sys.stdin.isatty() and sys.stdout.isatty() and not no_clipboard():
        ok = prompt_yes_no_box(
            "CLEAN SESSIONS",
            [
                f"Directory: {base}",
                f"Remove: {len(to_remove)} session(s) ({names})",
                f"Free: {freed_bytes:,} bytes",
            ],
            f"Delete {len(to_remove)} session(s)?",
            default_yes=False,
            yes_status=f"✓ Removing {len(to_remove)} session(s).",
            no_status="✗ Clean canceled.",
        )
        if not ok:
            return 2

    for d in to_remove:
        shutil.rmtree(d, ignore_errors=True)
    kept = len(sdirs) - len(to_remove)
    sys.stdout.write(
        f"Cleaned {len(to_remove)} session(s) ({names}; {freed_bytes:,} bytes freed) from {base}; {kept} kept.\n"
    )
    return 0


def format_sandbox_header(mode: str) -> str:
    norm = normalize_sandbox_mode(mode)
    if norm == "strict":
        return "strict (rw: Workdir, /tmp; secrets: hidden; net: on)"
    if norm == "nonet":
        return "nonet (rw: Workdir, /tmp; secrets: hidden; net: off)"
    if norm == "off":
        return "off"
    return norm


def format_start_bundle(
    session_name: str,
    stdin_body: str = "",
    work_dir: Path | None = None,
    now: datetime | None = None,
    sandbox_mode: str | None = None,
) -> dict[str, object]:
    wdir = (work_dir if work_dir is not None else get_work_dir()).resolve()
    sb_mode = get_sandbox_mode(override=sandbox_mode)
    sb_hdr = format_sandbox_header(sb_mode)
    ts = (now or datetime.now().astimezone()).strftime("%Y-%m-%d %H:%M %Z").strip()
    clean_body = stdin_body.strip()
    bundle_header_lines = [
        f"Session: {session_name}",
        f"Next-Block: {session_name}/1",
        f"Workdir: {wdir}",
        f"Sandbox: {sb_hdr}",
        f"Date: {ts}",
    ]
    bundle_header_text = "\n".join(bundle_header_lines) + "\n"
    full_text = bundle_header_text + ("\n" + clean_body + "\n" if clean_body else "")
    total_lines = len(full_text.splitlines())
    total_tokens = count_tokens(full_text.encode("utf-8"))["gpt"]
    console_lines = [
        f"Session: {session_name}",
        f"Next-Block: {session_name}/1",
        f"Date: {ts}",
        f"Workdir: {wdir}",
        f"Sandbox: {sb_hdr}",
        f"Total: {total_lines} lines (~{total_tokens} tokens)",
    ]
    return {
        "console_lines": console_lines,
        "full": full_text,
        "total_lines": total_lines,
        "total_tokens": total_tokens,
        "sandbox": sb_mode,
    }


def set_session_bundle_header(sdir: Path, key: str, value: str) -> None:
    bundle_path = ensure_session_bundle(sdir)
    text = bundle_path.read_text(encoding="utf-8", errors="replace")
    lines = text.splitlines()
    header_end = 0
    target_idx = -1
    key_lower = key.lower()
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if not stripped or stripped.startswith("====="):
            header_end = idx
            break
        m = BUNDLE_HEADER_RE.match(stripped)
        if not m:
            header_end = idx
            break
        k = re.sub(r"\s+", "-", m.group(1).strip().lower())
        if k == key_lower:
            target_idx = idx
        header_end = idx + 1
    new_line = f"{key}: {value}"
    if target_idx >= 0:
        lines[target_idx] = new_line
    else:
        insert_at = max(0, header_end - 1) if header_end > 0 else 0
        lines.insert(insert_at, new_line)
    write_private(bundle_path, "\n".join(lines) + "\n", overwrite=True)


def cmd_start(argv: list[str], stdin_text: str | None = None, sandbox_override: str | None = None) -> int:
    prog = prog_name()
    force = False
    session_arg: str | None = None
    sb_arg: str | None = sandbox_override
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--force":
            force = True
            i += 1
        elif a == "--no-sandbox":
            sb_arg = "off"
            i += 1
        elif a == "--sandbox":
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                sb_arg = argv[i + 1]
                i += 2
            else:
                sb_arg = "strict"
                i += 1
        elif a.startswith("--sandbox="):
            sb_arg = a.split("=", 1)[1] or "strict"
            i += 1
        elif a == "--session":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --session requires an argument")
            session_arg = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            raise SystemExit(
                f"{prog}: usage: <command> | {prog} [--start] [--session NAME] [--sandbox [MODE]] [--force]"
            )
        else:
            if session_arg is None and re.fullmatch(r"s\d+", a):
                session_arg = a
                i += 1
            else:
                raise SystemExit(
                    f"{prog}: usage: <command> | {prog} [--start] [--session NAME] [--sandbox [MODE]] [--force]"
                )

    if stdin_text is None:
        if sys.stdin.isatty():
            sys.stderr.write(
                f"{prog}: --start expects a context bundle on stdin (e.g. '{prog} --start < context.txt')\n"
            )
            return 2
        stdin_text = sys.stdin.read()

    sdir = start_session(session_arg, force=force, sandbox_mode=sb_arg)
    session_name = sdir.name
    bundle_path = sdir / "0.txt"
    res = format_start_bundle(session_name=session_name, stdin_body=stdin_text, sandbox_mode=sb_arg)
    write_private(bundle_path, str(res["full"]), overwrite=True)
    wdir = get_work_dir(sdir).resolve()
    sb_mode = get_sandbox_mode(sdir, override=sb_arg)
    body_lines = [
        f"Next-Block: {session_name}/1",
        f"Workdir: {wdir}",
    ]
    if sb_mode != "off":
        body_lines.append(f"Sandbox: {format_sandbox_header(sb_mode)}")
    body_lines.append(f"Bundle: {bundle_path}")
    label0 = f"{session_name}/0"
    if not in_run_block() and sys.stdout.isatty() and clipboard_mode() == "prompt" and clipboard_command(bundle_path) is not None:
        offer_clipboard_copy(label0, bundle_path, ok=True, rc=0, title_kind="START BUNDLE", extra_lines=body_lines)
    else:
        full_body = build_box_body_lines(bundle_path, rc=0, stats=stats_line(bundle_path), extra_lines=body_lines)
        sys.stdout.write(format_info_box(f"{label0} · START BUNDLE", full_body) + "\n")
        sys.stdout.flush()
        if not in_run_block():
            offer_clipboard_copy(label0, bundle_path, ok=True, rc=0, title_kind="START BUNDLE", extra_lines=body_lines)
    return 0


def ensure_session_bundle(
    sdir: Path, work_dir: Path | None = None, sandbox_mode: str | None = None
) -> Path:
    bundle_path = sdir / "0.txt"
    if not bundle_path.is_file():
        res = format_start_bundle(
            session_name=sdir.name, stdin_body="", work_dir=work_dir, sandbox_mode=sandbox_mode
        )
        write_private(bundle_path, str(res["full"]), overwrite=True)
    return bundle_path


def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    parts = []
    for p in re.split(r"[^0-9]+", v):
        if p:
            parts.append(int(p))
    return tuple(parts)


def fetch_remote_script(url: str | None = None) -> str:
    cfg_url, _ = get_setting("update_url")
    target_url = url or cfg_url
    if target_url.startswith(("http://", "https://")) and "?" not in target_url:
        target_url = f"{target_url}?t={int(time.time())}"
    req = urllib.request.Request(
        target_url,
        headers={"User-Agent": f"run_block/{VERSION}", "Cache-Control": "no-cache", "Pragma": "no-cache"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER and REPO_MARKER not in data:
        raise ValueError("downloaded file does not contain expected repository marker")
    ast.parse(data)
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} --update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None, target_path: Path | None = None) -> int:
    prog = prog_name()
    dest = target_path or Path(__file__).resolve()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and version_tuple(remote_ver) <= version_tuple(VERSION):
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    prog = prog_name()
    if "-h" in args or "--help" in args:
        sys.stdout.write(usage_text())
        return 0
    if "-V" in args or "--version" in args:
        sys.stdout.write(f"{prog} {VERSION}\n")
        return 0
    if "--agents" in args or "--agents-md" in args:
        sys.stdout.write(agents_markdown(prog) + "\n")
        return 0
    if args and args[0] == "--plan":
        if len(args) != 1:
            raise SystemExit(f"{prog}: usage: {prog} --plan < script.sh")
        return cmd_plan(sys.stdin.read())
    if args and args[0] == "--clean":
        return cmd_clean(args[1:])

    if args and args[0] == "--sandbox" and sys.stdin.isatty():
        rest_sb = args[1:]
        if not rest_sb or not any("/" in x for x in rest_sb):
            return cmd_sandbox(rest_sb)

    auto_yes = False
    sandbox_override: str | None = None
    filtered: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-y", "--yes", "--headless"):
            auto_yes = True
            i += 1
        elif a == "--no-sandbox":
            sandbox_override = "off"
            i += 1
        elif a.startswith("--sandbox="):
            sandbox_override = a.split("=", 1)[1] or "strict"
            i += 1
        elif a == "--sandbox":
            if i + 1 < len(args) and args[i + 1].lower() in ("off", "0", "false", "on", "1", "true", "auto", "strict", "nonet", "no-net"):
                sandbox_override = args[i + 1]
                i += 2
            else:
                sandbox_override = "strict"
                i += 1
        else:
            filtered.append(a)
            i += 1
    args = filtered

    if not args:
        if not sys.stdin.isatty():
            return cmd_start([], sandbox_override=sandbox_override)
        if sandbox_override is not None:
            return cmd_sandbox([sandbox_override])
        sys.stderr.write(usage_text())
        return 2

    if args[0] in ("--list", "-l"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --list [session]")
        return cmd_list(args[1] if len(args) == 2 else None)

    if args[0] == "--show":
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --show [session/step]")
        return cmd_show(args[1] if len(args) == 2 else None)

    if args[0] in ("--retry", "--rerun"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --retry [-y] [session/step]")
        return cmd_retry(
            args[1] if len(args) == 2 else None, auto_yes=auto_yes, sandbox_override=sandbox_override
        )

    if args[0] == "--check-update":
        if len(args) != 1:
            raise SystemExit(f"{prog}: usage: {prog} --check-update")
        return cmd_check_update()

    if args[0] in ("--update", "--self-update"):
        force = "--force" in args[1:]
        rest = [a for a in args[1:] if a != "--force"]
        if rest:
            raise SystemExit(f"{prog}: usage: {prog} --update [--force]")
        return cmd_update(force=force)

    if args[0] in ("--start", "--bundle"):
        return cmd_start(args[1:], sandbox_override=sandbox_override)

    if args[0] == "--fix":
        if len(args) != 2:
            raise SystemExit(f"{prog}: usage: {prog} --fix [-y] <session>/<target>")
        return cmd_fix(
            args[1], sys.stdin.read(), auto_yes=auto_yes, sandbox_override=sandbox_override
        )

    if len(args) != 1 or args[0].startswith("-"):
        raise SystemExit(
            f"{prog}: usage: {prog} [-y] <session>/<step> (or pipe bundle to '{prog}' to start a session; see --help)"
        )
    return cmd_normal(
        args[0], sys.stdin.read(), auto_yes=auto_yes, sandbox_override=sandbox_override
    )


