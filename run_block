def prompt_yes_no_box(
    title: str,
    content_lines: list[str],
    question: str,
    default_yes: bool = False,
    yes_status: str = "✓ Confirmed by user.",
    no_status: str = "✗ Canceled by user.",
    tty_streams: tuple[object, object] | None = None,
) -> bool:
    suffix = "[Y/n]:" if default_yes else "[y/N]:"
    prompt_line = f"-> {question} {suffix}"
    box, inner_width, cursor_offset = format_prompt_box(title, content_lines, prompt_line)
    bottom = f"└─{'─' * inner_width}─┘"
    try:
        if tty_streams is not None:
            tty_w, tty_r = tty_streams
            close_after = False
        else:
            tty_w, tty_r = open_tty()
            close_after = True
        try:
            tty_w.write(f"{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_confirm_key(tty_r, default_yes=default_yes)
                if action == "yes":
                    approved = True
                    break
                if action == "no":
                    approved = False
                    break
            status_line = yes_status if approved else no_status
            tty_w.write(f"\r{pad_box_line(status_line, inner_width)}\n{bottom}\n")
            tty_w.flush()
            return approved
        finally:
            if close_after:
                tty_w.close()
                tty_r.close()
    except OSError:
        return default_yes


def resolve_editor_command() -> list[str]:
    cfg_ed, _ = get_setting("editor")
    if cfg_ed and cfg_ed.lower() != "auto":
        return shlex.split(cfg_ed)
    for env_k in ("VISUAL", "EDITOR"):
        val = os.environ.get(env_k, "").strip()
        if val:
            return shlex.split(val)
    for candidate in ("vim", "vi", "less", "nano", "more"):
        if shutil.which(candidate):
            return [candidate]
    return ["vi"]


def open_script_in_editor(script_path: Path, tty_r, tty_w) -> None:
    cmd = resolve_editor_command() + [str(script_path)]
    try:
        subprocess.run(cmd, stdin=tty_r, stdout=tty_w, stderr=tty_w, check=False)
    except Exception as exc:
        tty_w.write(f"\n[editor error: {exc}]\n")
        tty_w.flush()


def read_confirm_key(tty_r, default_yes: bool) -> str:
    """Reads a single key: returns 'yes', 'no', or 'view'."""
    flush_tty_input(tty_r)
    if not HAS_PTY or termios is None or tty is None:
        ans = tty_r.readline().strip().lower()
        if ans in ("v", "view", "e", "edit"):
            return "view"
        if default_yes and ans in ("", "y", "yes"):
            return "yes"
        if not default_yes and ans in ("y", "yes"):
            return "yes"
        if ans in ("n", "no", "q", "esc"):
            return "no"
        return "invalid"
    try:
        fd = tty_r.fileno()
        old_attrs = termios.tcgetattr(fd)
    except Exception:
        ans = tty_r.readline().strip().lower()
        return "view" if ans in ("v", "view", "e", "edit") else ("yes" if ans in ("y", "yes") else "no")
    try:
        tty.setraw(fd, termios.TCSANOW)
        while True:
            ch = os.read(fd, 1)
            if not ch:
                return "no"
            if ch in (b"v", b"V", b"e", b"E"):
                return "view"
            if ch in (b"y", b"Y"):
                return "yes"
            if default_yes and ch in (b"\r", b"\n"):
                return "yes"
            if ch in (b"n", b"N", b"q", b"Q", b"\x03", b"\x04"):
                return "no"
            if ch == b"\x1b":
                rlist, _, _ = select.select([fd], [], [], 0.05)
                if rlist:
                    os.read(fd, 32)
                    continue
                return "no"
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        except Exception:
            pass


def confirm_execution(
    label: str,
    script_text: str,
    summary: dict[str, object] | None = None,
    script_path: Path | None = None,
) -> bool:
    if in_run_block():
        return True
    findings = scan_script_risks(script_text)
    if not sys.stdout.isatty() or no_clipboard():
        if findings:
            for f in findings:
                sys.stdout.write(f"[{label}] safety warning [{f['category']}]: {f['snippet']}\n")
            sys.stdout.flush()
        return True
    default_yes = (len(findings) == 0)
    box, inner_width, cursor_offset = format_safety_box(label, findings, default_yes=default_yes, summary=summary)
    bottom = f"└─{'─' * inner_width}─┘"
    prompt_suffix = "[Y/n/v(iew)]:" if default_yes else "[y/n/v(iew)]:"
    prompt_line = f"-> Execute this block? {prompt_suffix}"
    try:
        tty_w, tty_r = open_tty()
        with tty_w, tty_r:
            tty_w.write(f"{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_confirm_key(tty_r, default_yes=default_yes)
                if action == "view":
                    if script_path is not None and script_path.is_file():
                        open_script_in_editor(script_path, tty_r, tty_w)
                        p_offset = 2 + display_width(prompt_line)
                        tty_w.write(f"\r{pad_box_line(prompt_line, inner_width)}\n{bottom}\r\033[1A\033[{p_offset}C")
                        tty_w.flush()
                    continue
                if action == "yes":
                    approved = True
                    break
                if action == "no":
                    approved = False
                    break
            status_line = "✓ Approved by user." if approved else f"✗ Aborted (--retry {label})"
            tty_w.write(f"\r{pad_box_line(status_line, inner_width)}\n{bottom}\n")
            tty_w.flush()
            return approved
    except OSError:
        return True


def ensure_base() -> Path:
    BASE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        BASE_DIR.chmod(0o700)
    except OSError:
        pass
    return BASE_DIR


def next_session_name(base: Path) -> str:
    used = set()
    for p in base.iterdir():
        m = re.fullmatch(r"s(\d+)", p.name)
        if m:
            used.add(int(m.group(1)))
    n = 1
    while n in used:
        n += 1
    return f"s{n}"


def resolve_initial_session(base: Path) -> str:
    """Returns an existing prepared session (that has no step 1 yet) or the next new session name."""
    candidates: list[tuple[int, Path]] = []
    for p in base.iterdir():
        if p.is_dir():
            m = re.fullmatch(r"s(\d+)", p.name)
            if m:
                candidates.append((int(m.group(1)), p))
    if candidates:
        candidates.sort(key=lambda item: item[0])
        _, latest_dir = candidates[-1]
        has_blocks = bool(_iter_session_scripts(latest_dir)) or (latest_dir / "1.txt").exists() or (latest_dir / "1.aborted").exists()
        if not has_blocks:
            return latest_dir.name
    return next_session_name(base)


def start_session(name: str | None = None, force: bool = False) -> Path:
    base = ensure_base()
    if not name:
        name = next_session_name(base)
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        raise SystemExit(f"{prog_name()}: invalid session name: {name!r}")
    sdir = base / name
    if sdir.exists():
        if not force:
            if not sys.stdin.isatty():
                raise SystemExit(f"{prog_name()}: session {sdir} already exists (use --force to overwrite)")
            if sys.stdout.isatty() and not no_clipboard():
                ok = prompt_yes_no_box(
                    f"[{name}] [!] SESSION ALREADY EXISTS",
                    [f"Session directory already exists: {sdir}"],
                    f"Overwrite session {name}?",
                    default_yes=False,
                    yes_status=f"✓ Overwriting session {name}.",
                    no_status=f"✗ Aborted overwriting session {name}.",
                )
                if not ok:
                    raise SystemExit(f"{prog_name()}: aborted")
            else:
                sys.stderr.write(f"Session {sdir} already exists. Overwrite? [y/N] ")
                sys.stderr.flush()
                ans = sys.stdin.readline().strip().lower()
                if ans not in ("y", "yes"):
                    raise SystemExit(f"{prog_name()}: aborted")
        shutil.rmtree(sdir)
    sdir.mkdir(mode=0o700, parents=True)
    return sdir


def parse_ref(ref: str, allow_fix_step: bool) -> tuple[str, str]:
    pattern = r"^([A-Za-z0-9._-]+)/(\d+(?:_\d+)?)$" if allow_fix_step else r"^([A-Za-z0-9._-]+)/(\d+)$"
    m = re.fullmatch(pattern, ref.strip())
    if not m:
        kind = "<session>/<step> (e.g. s1/2 or s1/2_1)" if allow_fix_step else "<session>/<step> (e.g. s1/1)"
        raise SystemExit(f"{prog_name()}: invalid block reference {ref!r}; expected {kind}")
    return m.group(1), m.group(2)


def next_fix_step(step: str) -> str:
    if "_" in step:
        base, sub = step.split("_", 1)
        return f"{base}_{int(sub) + 1}"
    return f"{step}_1"


def write_private(path: Path, content: str, overwrite: bool = False) -> None:
    flags = os.O_WRONLY | os.O_CREAT | (os.O_TRUNC if overwrite else os.O_EXCL)
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)


def not_run_exit(label: str, sdir: Path, step_name: str, out_path: Path, msg: str, rc: int = 2) -> int:
    sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
    line = msg if msg.endswith("\n") else msg + "\n"
    clean_msg = msg.strip()
    prefix = f"[{label}] NOT RUN:"
    detail = clean_msg[len(prefix):].strip() if clean_msg.startswith(prefix) else clean_msg
    sys.stdout.write(format_info_box(f"[{label}] [!] NOT RUN", [detail]) + "\n")
    sys.stdout.flush()
    err_target = sdir / f"{step_name}.error.txt" if out_path.exists() else out_path
    try:
        write_private(err_target, line, overwrite=True)
        offer_clipboard_copy(label, err_target, ok=False, rc=rc)
    except Exception:
        pass
    return rc


# --- Built-in token and byte statistics ---
_ENC = None
_ENC_TRIED = False


def gpt_encoder():
    global _ENC, _ENC_TRIED
    if not _ENC_TRIED:
        _ENC_TRIED = True
        try:
            import tiktoken  # type: ignore[import-not-found]
            _ENC = tiktoken.get_encoding("o200k_base")
        except Exception:
            _ENC = None
    return _ENC


def count_tokens(data: bytes) -> dict[str, int | bool]:
    text = data.decode("utf-8", "replace")
    chars = len(text)
    enc = gpt_encoder()
    if enc is not None:
        gpt = len(enc.encode(text, disallowed_special=()))
    else:
        gpt = math.ceil(chars / 4)
    return {
        "bytes": len(data),
        "claude": math.ceil(chars / 3.5),
        "gpt": gpt,
        "gpt_exact": enc is not None,
        "gemini": math.ceil(chars / 4),
    }


def format_stats(data: bytes) -> str:
    s = count_tokens(data)
    mark = "" if s["gpt_exact"] else "~"
    size, claude, gpt, gemini = s["bytes"], s["claude"], s["gpt"], s["gemini"]
    return f"Size: {size:,} bytes | Tokens: Claude ~{claude:,} | GPT {mark}{gpt:,} | Gemini ~{gemini:,}"


def stats_line(path: Path) -> str | None:
    enabled, _ = get_setting("token_stats")
    if enabled == "false":
        return None
    try:
        return format_stats(path.read_bytes())
    except Exception:
        return None


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
CR_LINE_RE = re.compile(r"[^\n]*\r(?!\n)")


def run_script(
    label: str,
    script_path: Path,
    out_path: Path,
    header_lines: list[str] | None = None,
    cleanup_on_abort: list[Path] | None = None,
) -> int:
    work_dir = get_work_dir(script_path.parent)
    shell_bin, _ = get_setting("shell")
    is_ps = _is_powershell(shell_bin)
    script_text = script_path.read_text(encoding="utf-8")

    if is_ps:
        ps_check = (
            "$err = $null; "
            "[void][System.Management.Automation.Language.Parser]::ParseFile($args[0], [ref]$null, [ref]$err); "
            "if ($err) { foreach ($e in $err) { [Console]::Error.WriteLine($e.ToString()) }; exit 1 }"
        )
        chk_cmd = [shell_bin, "-NoProfile", "-NonInteractive", "-Command", ps_check, str(script_path)]
        exec_cmd = [shell_bin, "-NoProfile", "-File", str(script_path)]
    else:
        chk_cmd = [shell_bin, "-n", str(script_path)]
        exec_cmd = [shell_bin, str(script_path)]

    chk = subprocess.run(
        chk_cmd,
        cwd=work_dir,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if chk.returncode != 0:
        start_line = f"[{label}] START (script: {script_path})\n\n"
        msg = chk.stdout or "syntax check failed\n"
        end_line = f"[{label}] END (syntax error, exit {chk.returncode}) — output: {out_path}\n"
        full_output = start_line + msg + end_line
        box_lines = [f"Script: {script_path}", *(msg.rstrip("\n").splitlines())]
        sys.stdout.write(format_info_box(f"[{label}] [!] SYNTAX ERROR (exit {chk.returncode})", box_lines) + "\n")
        sys.stdout.flush()
        write_private(out_path, full_output)
        offer_clipboard_copy(label, out_path, ok=False, rc=chk.returncode)
        return chk.returncode

    aborted_marker = script_path.with_suffix(".aborted")
    summary_obj = summarize_script_actions(script_text, work_dir=work_dir)
    if not confirm_execution(label, script_text, summary=summary_obj, script_path=script_path):
        write_private(aborted_marker, "aborted\n", overwrite=True)
        return not_run_exit(label, script_path.parent, script_path.stem, out_path, f"[{label}] NOT RUN: aborted by user (re-run with: {prog_name()} --retry {label})", rc=130)
    aborted_marker.unlink(missing_ok=True)

    start_line = f"[{label}] START (script: {script_path})\n"
    log_chunks: list[str] = [start_line]
    start_box_lines = [f"Script: {script_path}"]
    for h in header_lines or []:
        log_chunks.append(h)
        for hl in h.rstrip("\n").splitlines():
            start_box_lines.append(hl)
    log_chunks.append("\n")
    sys.stdout.write(format_info_box(f"[{label}] START", start_box_lines) + "\n\n")
    sys.stdout.flush()

    tty_in = None
    master_fd = None
    slave_fd = None
    if HAS_PTY and sys.stdout.isatty() and not no_clipboard():
        try:
            tty_in = open("/dev/tty", "rb", buffering=0)
            master_fd, slave_fd = pty.openpty()
            attrs = termios.tcgetattr(slave_fd)
            attrs[1] &= ~termios.ONLCR
            termios.tcsetattr(slave_fd, termios.TCSANOW, attrs)
        except OSError:
            if tty_in is not None:
                tty_in.close()
                tty_in = None
            if master_fd is not None:
                os.close(master_fd)
                master_fd = None
            if slave_fd is not None:
                os.close(slave_fd)
                slave_fd = None

    child_env = {**os.environ, "IN_RUN_BLOCK": "1"}
    if master_fd is not None and slave_fd is not None:
        try:
            proc = subprocess.Popen(
                exec_cmd,
                cwd=work_dir,
                stdin=tty_in if tty_in is not None else slave_fd,
                stdout=slave_fd,
                stderr=slave_fd,
                env=child_env,
                close_fds=True,
            )
            os.close(slave_fd)
            slave_fd = None
            while True:
                try:
                    chunk = os.read(master_fd, 4096)
                except OSError:
                    break
                if not chunk:
                    break
                text = chunk.decode("utf-8", "replace")
                log_chunks.append(text)
                sys.stdout.write(text)
                sys.stdout.flush()
            rc = proc.wait()
        finally:
            if slave_fd is not None:
                os.close(slave_fd)
            if master_fd is not None:
                os.close(master_fd)
            if tty_in is not None:
                tty_in.close()
    else:
        proc = subprocess.Popen(
            exec_cmd,
            cwd=work_dir,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=child_env,
        )
        assert proc.stdout is not None
        while True:
            chunk = proc.stdout.read1(4096) if hasattr(proc.stdout, "read1") else proc.stdout.read(4096)
            if not chunk:
                break
            text = chunk.decode("utf-8", "replace")
            log_chunks.append(text)
            sys.stdout.write(text)
            sys.stdout.flush()
        proc.stdout.close()
        rc = proc.wait()
    if log_chunks and not log_chunks[-1].endswith("\n"):
        log_chunks.append("\n")
        sys.stdout.write("\n")
    exit_str = f" (exit {rc})" if rc != 0 else ""
    end_line = f"\n[{label}] END{exit_str} — output: {out_path}\n"
    log_chunks.append(end_line)
    if in_run_block() or not sys.stdout.isatty() or clipboard_mode() != "prompt":
        sys.stdout.write("\n" + format_info_box(f"[{label}] END{exit_str}", [f"Output: {out_path}"]) + "\n")
    sys.stdout.flush()
    full_output = CR_LINE_RE.sub("", ANSI_RE.sub("", "".join(log_chunks))).replace("\r\n", "\n")
    write_private(out_path, full_output)
    clip_target = resolve_clipboard_target(out_path, full_output)
    offer_clipboard_copy(label, clip_target, ok=(rc == 0), rc=rc)
    return rc


def resolve_clipboard_target(out_path: Path, full_output: str) -> Path:
    matches = re.findall(
        r"^\[[A-Za-z0-9._-]+\] Attach: (\S+)\s*$",
        full_output,
        flags=re.MULTILINE,
    )
    if matches:
        candidate = Path(matches[-1])
        if candidate.is_file():
            return candidate
    return out_path


def clipboard_command(out_path: Path) -> tuple[list[str], str] | None:
    if shutil.which("xclip") and os.environ.get("DISPLAY"):
        return ["xclip", "-selection", "clipboard"], f"xclip -selection clipboard < {out_path}"
    if shutil.which("wl-copy") and os.environ.get("WAYLAND_DISPLAY"):
        return ["wl-copy"], f"wl-copy < {out_path}"
    if shutil.which("pbcopy"):
        return ["pbcopy"], f"pbcopy < {out_path}"
    if shutil.which("xsel") and os.environ.get("DISPLAY"):
        return ["xsel", "--clipboard", "--input"], f"xsel --clipboard --input < {out_path}"
    if shutil.which("clip.exe"):
        return ["clip.exe"], f"clip.exe < {out_path}"
    return None


def copy_file_to_clipboard(cmd: list[str], out_path: Path) -> bool:
    try:
        with open(out_path, "rb") as f_in:
            r = subprocess.run(
                cmd,
                stdin=f_in,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            )
        return r.returncode == 0
    except Exception:
        return False


def display_width(text: str) -> int:
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in text)


def pad_box_line(text: str, inner_width: int) -> str:
    pad = max(0, inner_width - display_width(text))
    return f"│ {text}{' ' * pad} │"


def format_clipboard_box(
    label: str, out_path: Path, ok: bool = True, rc: int | None = None, stats: str | None = None
) -> tuple[str, int, int]:
    if rc is not None and rc != 0:
        state = f"END (exit {rc})"
    else:
        state = "END"
    title = f" [{label}] {state} "
    line2 = f"-> Press Enter to copy {out_path} to clipboard (v to view, Esc to skip)"
    copied_line = f"✓ Copied {out_path} to clipboard."
    stats_width = display_width(stats) if stats else 0
    inner_width = max(
        display_width(title),
        display_width(line2),
        display_width(copied_line),
        stats_width,
    )
    dashes = max(1, inner_width + 2 - display_width(title) - 1)
    top = f"┌─{title}{'─' * dashes}┐"
    bottom = f"└─{'─' * inner_width}─┘"
    rows = [pad_box_line(line2, inner_width)]
    if stats:
        rows.insert(0, pad_box_line(stats, inner_width))
    box = "\n".join([top, *rows, bottom])
    cursor_col_offset = 2 + display_width(line2)
    return box, inner_width, cursor_col_offset


def offer_clipboard_copy(
    label: str, out_path: Path, ok: bool = True, rc: int | None = None
) -> None:
    if in_run_block():
        return
    mode = clipboard_mode()
    if mode == "never":
        return
    clip = clipboard_command(out_path)
    if clip is None:
        return
    cmd, cmd_str = clip
    if mode == "auto":
        if copy_file_to_clipboard(cmd, out_path):
            sys.stdout.write(f"✓ Copied {out_path} to clipboard.\n")
        else:
            sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    if not sys.stdout.isatty():
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()
        return
    box, inner_width, cursor_offset = format_clipboard_box(
        label, out_path, ok=ok, rc=rc, stats=stats_line(out_path)
    )
    bottom = f"└─{'─' * inner_width}─┘"
    line2 = f"-> Press Enter to copy {out_path} to clipboard (v to view, Esc to skip)"
    try:
        tty_w, tty_r = open_tty()
        with tty_w, tty_r:
            tty_w.write(f"\n{box}\r\033[1A\033[{cursor_offset}C")
            tty_w.flush()
            while True:
                action = read_clipboard_key(tty_r)
                if action == "view":
                    if out_path.is_file():
                        open_script_in_editor(out_path, tty_r, tty_w)
                        tty_w.write(f"\r{pad_box_line(line2, inner_width)}\n{bottom}\r\033[1A\033[{cursor_offset}C")
                        tty_w.flush()
                    continue
                if action == "copy":
                    if copy_file_to_clipboard(cmd, out_path):
                        status_line = f"✓ Copied {out_path} to clipboard."
                    else:
                        status_line = f"✗ Clipboard copy failed; run: {cmd_str}"
                else:
                    status_line = "Skipped clipboard copy."
                break
            tty_w.write(f"\r{pad_box_line(status_line, inner_width)}\n{bottom}\n")
            tty_w.flush()
    except OSError:
        sys.stdout.write(f"[{label}] clipboard: {cmd_str}\n")
        sys.stdout.flush()


def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    parts = []
    for p in re.split(r"[^0-9]+", v):
        if p:
            parts.append(int(p))
    return tuple(parts)


def fetch_remote_script(url: str | None = None) -> str:
    cfg_url, _ = get_setting("update_url")
    target_url = url or cfg_url
    if target_url.startswith(("http://", "https://")) and "?" not in target_url:
        target_url = f"{target_url}?t={int(time.time())}"
    req = urllib.request.Request(
        target_url,
        headers={"User-Agent": f"run_block/{VERSION}", "Cache-Control": "no-cache", "Pragma": "no-cache"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER and REPO_MARKER not in data:
        raise ValueError("downloaded file does not contain expected repository marker")
    ast.parse(data)
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} --update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None, target_path: Path | None = None) -> int:
    prog = prog_name()
    dest = target_path or Path(__file__).resolve()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and version_tuple(remote_ver) <= version_tuple(VERSION):
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n")
    return 0


def cmd_normal(ref: str, payload: str) -> int:
    session, step = parse_ref(ref, allow_fix_step=False)
    step_num = int(step)
    if step_num < 1:
        raise SystemExit(f"{prog_name()}: step number must be >= 1")
    sdir = ensure_base() / session
    sdir.mkdir(mode=0o700, parents=True, exist_ok=True)
    label = f"{session}/{step}"
    script_path = _find_step_script(sdir, step)
    out_path = sdir / f"{step}.txt"

    aborted_marker = script_path.with_suffix(".aborted")
    overwrite = aborted_marker.exists()
    if overwrite:
        out_path.unlink(missing_ok=True)
        aborted_marker.unlink(missing_ok=True)
    elif script_path.exists() or out_path.exists():
        if sys.stdout.isatty() and not no_clipboard():
            if prompt_yes_no_box(
                f"[{label}] [!] STEP ALREADY EXISTS",
                [f"Step file already exists: {script_path}"],
                f"Overwrite and re-run {label}?",
                default_yes=False,
                yes_status=f"✓ Overwriting {label}.",
                no_status=f"✗ Keeping existing {label}.",
            ):
                overwrite = True
                out_path.unlink(missing_ok=True)
        if not overwrite:
            return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: step already exists — output: {out_path}")
    if step_num > 1 and not _find_step_script(sdir, str(step_num - 1)).exists():
        prev_label = f"{session}/{step_num - 1}"
        allow_skip = False
        if sys.stdout.isatty() and not no_clipboard():
            allow_skip = prompt_yes_no_box(
                f"[{label}] [!] MISSING PREVIOUS STEP",
                [f"Previous step {prev_label} has not been run yet."],
                f"Run {label} anyway?",
                default_yes=False,
                yes_status=f"✓ Proceeding with {label} (skipped {prev_label}).",
                no_status=f"✗ Canceled {label} (run {prev_label} first).",
            )
        if not allow_skip:
            return not_run_exit(
                label,
                sdir,
                step,
                out_path,
                f"[{label}] NOT RUN: previous step {prev_label} has not been run yet",
            )
    if not payload.strip():
        return not_run_exit(label, sdir, step, out_path, f"[{label}] NOT RUN: empty script on stdin")

    write_private(script_path, payload, overwrite=overwrite)
    return run_script(label, script_path, out_path, cleanup_on_abort=[script_path])


def cmd_fix(ref: str, fix_code: str) -> int:
    session, target = parse_ref(ref, allow_fix_step=True)
    sdir = ensure_base() / session
    src_script = _find_step_script(sdir, target)
    ext = src_script.suffix or _script_ext()
    new_step = next_fix_step(target)
    label = f"{session}/{new_step}"
    fix_path = sdir / f"{new_step}.fix"
    script_path = sdir / f"{new_step}{ext}"
    out_path = sdir / f"{new_step}.txt"

    if not src_script.exists():
        return not_run_exit(
            f"{session}/{target}",
            sdir,
            new_step,
            out_path,
            f"[{session}/{target}] NOT RUN: target script {src_script} does not exist",
        )

    if script_path.exists() or out_path.exists() or fix_path.exists():
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: fix step already exists — output: {out_path}")
    if not fix_code.strip():
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: empty fix on stdin")

    orig_text = src_script.read_text(encoding="utf-8")
    ns: dict[str, object] = {"text": orig_text, "re": re}
    try:
        exec(compile(fix_code, str(fix_path), "exec"), ns)
    except Exception as exc:
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: fix raised {type(exc).__name__}: {exc}")

    new_text = ns.get("text")
    if not isinstance(new_text, str):
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: fix did not leave a string in 'text'")
    if new_text == orig_text:
        return not_run_exit(label, sdir, new_step, out_path, f"[{label}] NOT RUN: fix made no changes to {src_script}")

    write_private(fix_path, fix_code)
    write_private(script_path, new_text)
    diff = "".join(
        difflib.unified_diff(
            orig_text.splitlines(keepends=True),
            new_text.splitlines(keepends=True),
            fromfile=f"{target}{ext}",
            tofile=f"{new_step}{ext}",
        )
    )
    header = [f"[{label}] patched {target}{ext} -> {new_step}{ext}:\n", diff]
    return run_script(label, script_path, out_path, header_lines=header, cleanup_on_abort=[fix_path, script_path])


def _step_sort_key(stem: str) -> tuple[int, int]:
    if "_" in stem:
        b, s = stem.split("_", 1)
        return (int(b) if b.isdigit() else 0, int(s) if s.isdigit() else 0)
    return (int(stem) if stem.isdigit() else 0, 0)


def _step_status(sdir: Path, stem: str) -> str:
    if (sdir / f"{stem}.aborted").exists():
        return "ABORTED"
    out_p = sdir / f"{stem}.txt"
    if out_p.is_file():
        txt = out_p.read_text(encoding="utf-8", errors="replace")
        label = f"{sdir.name}/{stem}"
        matches = re.findall(rf"^\[{re.escape(label)}\]\s+(END|SUCCESS|FAILED|NOT RUN)([^\n]*)", txt, flags=re.MULTILINE)
        if matches:
            kind, rest = matches[-1]
            return (kind + rest.split("—")[0]).strip()
        return "DONE"
    return "SAVED"


def _find_latest_step(session: str | None = None) -> tuple[str, str]:
    base = ensure_base()
    if session:
        sdirs = [base / session] if (base / session).is_dir() else []
    else:
        sdirs = sorted(
            [p for p in base.iterdir() if p.is_dir()],
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
    for sdir in sdirs:
        scripts = [p.stem for p in _iter_session_scripts(sdir)]
        if scripts:
            return sdir.name, scripts[-1]
    raise SystemExit(f"{prog_name()}: no saved blocks found in {base}")


def default_start_template(prog: str | None = None) -> str:
    cmd = prog or prog_name()
    lines = [
        f"# {START_FILE_NAME} — session context bundle specification for '{cmd} --start'",
        "# Plain lines are file paths (read directly as UTF-8 relative to the project root).",
        "# Lines starting with '$ ' (or '! ') are shell commands executed in the project directory.",
        "",
        f"$ {cmd} --agents",
        f"$ {cmd} --rules",
        "",
        "AGENTS.md",
        "",
        "$ git status -sb",
        "$ git branch -vv",
        "$ git log --oneline -10",
        "",
    ]
    return "\n".join(lines)


def cmd_init_start(force: bool = False, target_dir: Path | None = None) -> int:
    prog = prog_name()
    base_dir = target_dir if target_dir is not None else Path.cwd()
    path = base_dir / START_FILE_NAME
    if path.exists() and not force:
        sys.stderr.write(f"{prog}: {path} already exists (use --force to overwrite)\n")
        return 2
    path.write_text(default_start_template(prog), encoding="utf-8")
    sys.stdout.write(f"{prog}: wrote starter {START_FILE_NAME} to {path}\n")
    return 0


def find_start_file(work_dir: Path) -> tuple[Path | None, Path]:
    cwd = Path.cwd().resolve()
    wdir = work_dir.resolve()
    # Walk from cwd up to work_dir (if cwd is inside work_dir)
    if cwd == wdir or wdir in cwd.parents:
        cur = cwd
        while True:
            candidate = cur / START_FILE_NAME
            if candidate.is_file():
                return candidate, cur
            if cur == wdir or cur.parent == cur:
                break
            cur = cur.parent
    wdir_candidate = wdir / START_FILE_NAME
    if wdir_candidate.is_file():
        return wdir_candidate, wdir
    seen_bases: list[Path] = []
    for base in (cwd, wdir):
        if base in seen_bases:
            continue
        seen_bases.append(base)
        try:
            sub_matches = sorted(
                p / START_FILE_NAME
                for p in base.iterdir()
                if p.is_dir() and not p.name.startswith(".") and (p / START_FILE_NAME).is_file()
            )
            if len(sub_matches) == 1:
                return sub_matches[0], sub_matches[0].parent
        except OSError:
            pass
    return None, wdir


def parse_start_spec(text: str) -> list[tuple[str, str]]:
    """Returns list of (kind, value) where kind is 'file' or 'cmd'."""
    entries: list[tuple[str, str]] = []
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("$ ") or line.startswith("! "):
            cmd_str = line[2:].strip()
            if cmd_str:
                entries.append(("cmd", cmd_str))
        elif line in ("$", "!"):
            continue
        else:
            entries.append(("file", line))
    return entries


def _run_start_command(cmd_str: str, cwd: Path) -> tuple[int, str]:
    prog = prog_name()
    self_path = str(Path(__file__).resolve())
    # If the command invokes '<prog> --agents' directly, call our own agents_markdown() in-process
    if re.fullmatch(rf"{re.escape(prog)}\s+--agents(?:-md)?", cmd_str) or re.fullmatch(r"run_block\s+--agents(?:-md)?", cmd_str):
        return 0, agents_markdown(prog)
    if re.match(rf"^(?:{re.escape(prog)}|run_block)\s+--rules(?:\s+.*)?$", cmd_str):
        try:
            parts = shlex.split(cmd_str)[2:]
            buf = []
            if any(a in ("--list", "-l") for a in parts):
                pass
            else:
                return 0, rules_markdown(parts).rstrip()
        except SystemExit as exc:
            return 1, str(exc)
    if re.match(rf"^(?:{re.escape(prog)}|run_block)\s+--tree(?:\s+.*)?$", cmd_str):
        try:
            parts = shlex.split(cmd_str)[2:]
            return 0, _tree_from_args(parts, default_dir=cwd).rstrip()
        except SystemExit as exc:
            return 1, str(exc)
    shell_bin, _ = get_setting("shell")
    shell_args = [shell_bin, "-NoProfile", "-Command", cmd_str] if _is_powershell(shell_bin) else [shell_bin, "-c", cmd_str]
    env = {**os.environ, "IN_RUN_BLOCK": "1", "PYTHONUTF8": "1"}
    # Ensure the directory containing this script is on PATH
    script_dir = str(Path(self_path).parent)
    env["PATH"] = f"{script_dir}{os.pathsep}{env.get('PATH', '')}"
    try:
        r = subprocess.run(
            shell_args,
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=env,
            check=False,
        )
        return r.returncode, r.stdout.decode("utf-8", errors="replace").rstrip()
    except OSError as exc:
        return 1, f"[error running {cmd_str!r}: {exc}]"


def build_start_bundle(
    session_name: str,
    work_dir: Path | None = None,
    extra_files: list[str] | None = None,
    prompt_text: str | None = None,
    now: datetime | None = None,
) -> dict[str, object]:
    prog = prog_name()
    wdir = (work_dir if work_dir is not None else get_work_dir()).resolve()
    start_file, spec_dir = find_start_file(wdir)
    if start_file is not None:
        entries = parse_start_spec(start_file.read_text(encoding="utf-8"))
        spec_source = str(start_file)
    else:
        spec_source = "built-in defaults"
        entries = [("cmd", f"{prog} --agents")]
        if (spec_dir / "AGENTS.md").is_file():
            entries.append(("file", "AGENTS.md"))
        if (spec_dir / ".git").exists():
            entries.append(("cmd", "git status -sb"))

    sections: list[tuple[str, str]] = []
    warnings: list[str] = []
    included_files: set[Path] = set()

    def add_file_section(rel_path: str, base_folder: Path, explicit: bool) -> None:
        clean = rel_path.strip()
        if not clean:
            return
        p = (base_folder / clean).resolve() if not Path(clean).is_absolute() else Path(clean).resolve()
        if p in included_files:
            return
        if not p.is_file():
            if explicit or start_file is not None:
                warnings.append(f"missing file: {clean}")
            return
        included_files.add(p)
        try:
            disp = str(p.relative_to(spec_dir))
        except ValueError:
            disp = str(p)
        content = p.read_text(encoding="utf-8", errors="replace").rstrip()
        sections.append((f"File: {disp}", content))

    for kind, val in entries:
        if kind == "file":
            add_file_section(val, spec_dir, explicit=False)
        elif kind == "cmd":
            rc, out = _run_start_command(val, spec_dir)
            if rc != 0:
                warnings.append(f"command exited {rc}: {val}")
            sections.append((f"$ {val}", out))

    for extra in extra_files or []:
        add_file_section(extra, Path.cwd().resolve(), explicit=True)

    if prompt_text and prompt_text.strip():
        sections.append(("Prompt", prompt_text.strip()))

    ts = (now or datetime.now().astimezone()).strftime("%Y-%m-%d %H:%M %Z").strip()
    manifest_lines: list[str] = []
    body_blocks: list[str] = []
    for title, content in sections:
        n_lines = len(content.splitlines()) if content else 0
        t_counts = count_tokens(content.encode("utf-8"))
        approx_tok = t_counts["gpt"]
        manifest_lines.append(f"  - {title}: {n_lines} lines (~{approx_tok} tokens)")
        body_blocks.append(f"===== {title} =====\n{content}\n")

    console_header_lines = [
        f"# {prog} session context bundle",
        f"Session: {session_name}",
        f"Next block: {session_name}/1",
        f"Date: {ts}",
        f"Workdir: {spec_dir}",
        f"Spec: {spec_source}",
        "Included sections:",
        *manifest_lines,
    ]
    if warnings:
        console_header_lines.append("Warnings:")
        console_header_lines.extend(f"  - {w}" for w in warnings)

    bundle_header_lines = [
        f"Session: {session_name}",
        f"Next block: {session_name}/1",
        f"Workdir: {spec_dir}",
    ]

    header_text = "\n".join(console_header_lines) + "\n"
    bundle_header_text = "\n".join(bundle_header_lines) + "\n"
    body_text = "\n".join(body_blocks)
    full_text = bundle_header_text + "\n" + body_text
    total_lines = len(full_text.splitlines())
    total_tokens = count_tokens(full_text.encode("utf-8"))["gpt"]
    return {
        "header": header_text,
        "body": body_text,
        "full": full_text,
        "warnings": warnings,
        "total_lines": total_lines,
        "total_tokens": total_tokens,
    }


def cmd_start(argv: list[str]) -> int:
    prog = prog_name()
    force = False
    session_arg: str | None = None
    prompt_parts: list[str] = []
    extra_files: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--force":
            force = True
            i += 1
        elif a == "--session":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --session requires an argument")
            session_arg = argv[i + 1]
            i += 2
        elif a in ("-p", "--prompt"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            prompt_parts.append(argv[i + 1])
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option for --start: {a}")
        else:
            extra_files.append(a)
            i += 1

    # Backward compatibility: if a single positional argument is not an existing file and matches session name (e.g. s2)
    if session_arg is None and len(extra_files) == 1 and not Path(extra_files[0]).exists() and re.fullmatch(r"s\d+", extra_files[0]):
        session_arg = extra_files.pop(0)

    sdir = start_session(session_arg, force=force)
    session_name = sdir.name
    bundle_path = sdir / "0.txt"
    prompt_text = "\n\n".join(prompt_parts) if prompt_parts else None
    res = build_start_bundle(
        session_name=session_name,
        extra_files=extra_files,
        prompt_text=prompt_text,
    )
    write_private(bundle_path, str(res["full"]), overwrite=True)
    hdr_lines = str(res["header"]).rstrip("\n").splitlines()
    if hdr_lines and hdr_lines[0].startswith("# "):
        hdr_lines = hdr_lines[1:]
    hdr_lines.append(f"Total: {res['total_lines']} lines (~{res['total_tokens']} tokens)")
    hdr_lines.append(f"Bundle: {bundle_path}")
    sys.stdout.write(format_info_box(f"[{session_name}/0] START BUNDLE", hdr_lines) + "\n")
    sys.stdout.flush()
    if not in_run_block():
        offer_clipboard_copy(f"{session_name}/0", bundle_path, ok=True, rc=0)
    return 0


def cmd_list(session: str | None = None) -> int:
    base = ensure_base()
    if not session:
        sdirs = sorted([p for p in base.iterdir() if p.is_dir()], key=lambda p: p.stat().st_mtime)
        if not sdirs:
            sys.stdout.write(f"No sessions in {base}\n")
            return 0
        sys.stdout.write(f"Sessions in {base}:\n")
        for sdir in sdirs:
            scripts = [p.stem for p in _iter_session_scripts(sdir)]
            has_bundle = (sdir / "0.txt").is_file()
            if scripts:
                last = f"{sdir.name}/{scripts[-1]} ({_step_status(sdir, scripts[-1])})"
            elif has_bundle:
                last = f"{sdir.name}/0 (BUNDLE)"
            else:
                last = "empty"
            sys.stdout.write(f"  {sdir.name:<8}  {len(scripts):>3} block(s)   last: {last}\n")
        session = sdirs[-1].name
        sys.stdout.write(f"\nRecent blocks in {session}:\n")
    else:
        sdir = base / session
        if not sdir.is_dir():
            raise SystemExit(f"{prog_name()}: session {session!r} not found in {base}")
        sys.stdout.write(f"Blocks in {session}:\n")
    sdir = base / session
    if (sdir / "0.txt").is_file():
        ref0 = f"{session}/0"
        sys.stdout.write(f"  {ref0:<10}  {'BUNDLE':<24}  Session context bundle (0.txt)\n")
    script_paths = _iter_session_scripts(sdir)
    for sp in script_paths[-15:]:
        stem = sp.stem
        st = _step_status(sdir, stem)
        sh_text = sp.read_text(encoding="utf-8", errors="replace")
        summary = summarize_script_actions(sh_text)
        rows = summary.get("rows") or []
        desc = "; ".join(f"{k}: {v}" for k, v in rows[:2]) if rows else ""
        if len(desc) > 56:
            desc = desc[:53] + "..."
        ref = f"{session}/{stem}"
        sys.stdout.write(f"  {ref:<10}  {st:<24}  {desc}\n")
    return 0


def cmd_show(ref: str | None = None) -> int:
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = _find_latest_step()
    sdir = ensure_base() / session
    script_path = _find_step_script(sdir, step)
    out_path = sdir / f"{step}.txt"
    if step == "0" and out_path.is_file():
        sys.stdout.write(f"=== [{session}/0] Bundle: {out_path} ===\n")
        sys.stdout.write(out_path.read_text(encoding="utf-8", errors="replace"))
        return 0
    if not script_path.is_file():
        raise SystemExit(f"{prog_name()}: block {session}/{step} not found ({script_path})")
    sys.stdout.write(f"=== [{session}/{step}] Script: {script_path} ({_step_status(sdir, step)}) ===\n")
    sys.stdout.write(script_path.read_text(encoding="utf-8", errors="replace"))
    if out_path.is_file():
        sys.stdout.write(f"\n=== [{session}/{step}] Output: {out_path} ===\n")
        sys.stdout.write(out_path.read_text(encoding="utf-8", errors="replace"))
    return 0


def cmd_retry(ref: str | None = None) -> int:
    if ref:
        session, step = parse_ref(ref, allow_fix_step=True)
    else:
        session, step = _find_latest_step()
    sdir = ensure_base() / session
    script_path = _find_step_script(sdir, step)
    out_path = sdir / f"{step}.txt"
    if not script_path.is_file():
        raise SystemExit(f"{prog_name()}: block {session}/{step} not found ({script_path})")
    out_path.unlink(missing_ok=True)
    (sdir / f"{step}.aborted").unlink(missing_ok=True)
    return run_script(f"{session}/{step}", script_path, out_path, cleanup_on_abort=[])


def _dir_size_bytes(path: Path) -> int:
    total = 0
    try:
        for p in path.rglob("*"):
            if p.is_file():
                try:
                    total += p.stat().st_size
                except OSError:
                    pass
    except OSError:
        pass
    return total


def cmd_clean(argv: list[str]) -> int:
    prog = prog_name()
    keep = 5
    clean_all = False
    yes = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--all":
            clean_all = True
            keep = 0
            i += 1
        elif a in ("-y", "--yes", "--force"):
            yes = True
            i += 1
        elif a == "--keep":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --keep requires a non-negative integer")
            try:
                keep = int(argv[i + 1])
            except ValueError:
                raise SystemExit(f"{prog}: invalid --keep value: {argv[i + 1]!r}")
            if keep < 0:
                raise SystemExit(f"{prog}: --keep must be >= 0")
            i += 2
        elif a.startswith("--keep="):
            val_s = a.split("=", 1)[1]
            try:
                keep = int(val_s)
            except ValueError:
                raise SystemExit(f"{prog}: invalid --keep value: {val_s!r}")
            if keep < 0:
                raise SystemExit(f"{prog}: --keep must be >= 0")
            i += 1
        else:
            raise SystemExit(f"{prog}: usage: {prog} --clean [--keep N | --all] [--yes]")

    base = ensure_base()
    sdirs = sorted(
        [p for p in base.iterdir() if p.is_dir()],
        key=lambda p: (p.stat().st_mtime, p.name),
    )
    if clean_all or keep == 0:
        to_remove = sdirs
    elif len(sdirs) > keep:
        to_remove = sdirs[: len(sdirs) - keep]
    else:
        to_remove = []

    if not to_remove:
        sys.stdout.write(f"Nothing to clean in {base} ({len(sdirs)} session(s) kept).\n")
        return 0

    freed_bytes = sum(_dir_size_bytes(d) for d in to_remove)
    names = ", ".join(d.name for d in to_remove)
    if not yes and sys.stdin.isatty() and sys.stdout.isatty() and not no_clipboard():
        ok = prompt_yes_no_box(
            "[CLEAN] [!] PRUNE SESSIONS",
            [
                f"Directory: {base}",
                f"Sessions to remove ({len(to_remove)}): {names}",
                f"Disk space to free: {freed_bytes:,} bytes",
            ],
            f"Delete {len(to_remove)} session(s)?",
            default_yes=False,
            yes_status=f"✓ Removing {len(to_remove)} session(s).",
            no_status="✗ Clean canceled.",
        )
        if not ok:
            return 2

    for d in to_remove:
        shutil.rmtree(d, ignore_errors=True)
    kept = len(sdirs) - len(to_remove)
    sys.stdout.write(
        f"Cleaned {len(to_remove)} session(s) ({names}; {freed_bytes:,} bytes freed) from {base}; {kept} kept.\n"
    )
    return 0


_TREE_SKIP_DIRS = {
    ".git",
    "__pycache__",
    "node_modules",
    ".venv",
    "venv",
    "dist",
    "build",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    "target",
}


def _collect_repo_files(root: Path) -> list[str]:
    try:
        r = subprocess.run(
            ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False,
        )
        if r.returncode == 0:
            files = []
            for raw in r.stdout.splitlines():
                rel = raw.strip()
                if not rel:
                    continue
                p = root / rel
                if p.is_file() and not p.is_symlink():
                    files.append(Path(rel).as_posix())
            return sorted(set(files))
    except Exception:
        pass

    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(
            d for d in dirnames if d not in _TREE_SKIP_DIRS and not d.startswith(".git")
        )
        rel_dir = Path(dirpath).relative_to(root)
        for fn in sorted(filenames):
            p = Path(dirpath) / fn
            if p.is_file() and not p.is_symlink():
                rel_p = (rel_dir / fn).as_posix() if str(rel_dir) != "." else fn
                files.append(rel_p)
    return sorted(set(files))


def _inspect_file_meta(path: Path) -> tuple[int, bool, int]:
    """Returns (lines, is_binary, byte_size)."""
    try:
        size = path.stat().st_size
        with path.open("rb") as f:
            head = f.read(4096)
            if b"\x00" in head:
                return 0, True, size
            rest = f.read(512 * 1024)
        data = head + rest
        n_lines = data.count(b"\n") + (1 if data and not data.endswith(b"\n") else 0)
        return n_lines, False, size
    except OSError:
        return 0, False, 0


def build_repo_tree(
    root_dir: Path | None = None,
    max_lines: int = 120,
    max_tokens: int = 1200,
) -> str:
    root = (root_dir if root_dir is not None else get_work_dir()).resolve()
    rel_files = _collect_repo_files(root)
    file_info: dict[str, tuple[int, bool, int]] = {}
    dir_files: dict[str, list[str]] = {"": []}
    dir_Subdirs: dict[str, list[str]] = {"": []}
    all_dirs: set[str] = {""}

    for rel in rel_files:
        info = _inspect_file_meta(root / rel)
        file_info[rel] = info
        parts = rel.split("/")
        cur = ""
        for part in parts[:-1]:
            nxt = f"{cur}/{part}" if cur else part
            if nxt not in all_dirs:
                all_dirs.add(nxt)
                dir_files[nxt] = []
                dir_Subdirs[nxt] = []
                dir_Subdirs[cur].append(nxt)
            cur = nxt
        dir_files[cur].append(rel)

    for d in all_dirs:
        dir_Subdirs[d].sort()
        dir_files[d].sort()

    dir_totals: dict[str, tuple[int, int]] = {}
    for d in sorted(all_dirs, key=lambda x: (0 if not x else x.count("/") + 1), reverse=True):
        f_cnt = len(dir_files[d])
        l_cnt = sum(file_info[f][0] for f in dir_files[d])
        for sub in dir_Subdirs[d]:
            sf, sl = dir_totals[sub]
            f_cnt += sf
            l_cnt += sl
        dir_totals[d] = (f_cnt, l_cnt)

    def render_dir(d: str, prefix: str, collapsed: set[str], root_file_limit: int | None) -> list[str]:
        out: list[str] = []
        subs = dir_Subdirs[d]
        files = dir_files[d]
        extra_files = 0
        if d == "" and root_file_limit is not None and len(files) > root_file_limit:
            extra_files = len(files) - root_file_limit
            files = files[:root_file_limit]

        entries: list[tuple[str, str]] = [("dir", s) for s in subs] + [("file", f) for f in files]
        if extra_files > 0:
            entries.append(("more", f"... (+{extra_files} more files)"))

        for idx, (kind, item) in enumerate(entries):
            is_last = idx == len(entries) - 1
            conn = "└── " if is_last else "├── "
            child_prefix = prefix + ("    " if is_last else "│   ")
            if kind == "dir":
                name = item.rsplit("/", 1)[-1]
                if item in collapsed:
                    fc, lc = dir_totals[item]
                    out.append(f"{prefix}{conn}{name}/ ({fc} file{'s' if fc != 1 else ''}, {lc:,}L)")
                else:
                    out.append(f"{prefix}{conn}{name}/")
                    out.extend(render_dir(item, child_prefix, collapsed, None))
            elif kind == "file":
                name = item.rsplit("/", 1)[-1]
                lines_n, is_bin, sz = file_info[item]
                tag = f"({sz:,}B)" if is_bin else f"({lines_n}L)"
                out.append(f"{prefix}{conn}{name} {tag}")
            else:
                out.append(f"{prefix}{conn}{item}")
        return out

    collapsed: set[str] = set()
    root_limit: int | None = None
    total_f, total_l = dir_totals[""]

    while True:
        body = [f"{root.name}/"] + render_dir("", "", collapsed, root_limit)
        footer = f"# Total: {total_f} file{'s' if total_f != 1 else ''}, {total_l:,} lines"
        full_lines = body + [footer]
        tok = int(count_tokens("\n".join(full_lines).encode("utf-8"))["gpt"])
        if len(full_lines) <= max_lines and tok <= max_tokens:
            return "\n".join(full_lines) + "\n"

        candidates = [
            d for d in all_dirs
            if d != "" and d not in collapsed and not any(
                d.startswith(c + "/") for c in collapsed
            ) and dir_totals[d][0] > 1
        ]
        if candidates:
            # Collapse the deepest directory with the most files first
            best = max(candidates, key=lambda d: (d.count("/"), dir_totals[d][0]))
            collapsed.add(best)
            continue

        cur_root_files = len(dir_files[""]) if root_limit is None else root_limit
        if cur_root_files > 5:
            root_limit = max(5, cur_root_files // 2)
            continue
        return "\n".join(full_lines[: max(2, max_lines - 1)] + [footer]) + "\n"


def _tree_from_args(argv: list[str], default_dir: Path | None = None) -> str:
    prog = prog_name()
    max_lines = 120
    max_tokens = 1200
    target_dir: Path | None = default_dir
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--max-lines":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --max-lines requires an integer")
            try:
                max_lines = max(5, int(argv[i + 1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-lines value: {argv[i + 1]!r}")
            i += 2
        elif a.startswith("--max-lines="):
            try:
                max_lines = max(5, int(a.split("=", 1)[1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-lines value: {a!r}")
            i += 1
        elif a == "--max-tokens":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --max-tokens requires an integer")
            try:
                max_tokens = max(20, int(argv[i + 1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-tokens value: {argv[i + 1]!r}")
            i += 2
        elif a.startswith("--max-tokens="):
            try:
                max_tokens = max(20, int(a.split("=", 1)[1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-tokens value: {a!r}")
            i += 1
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: usage: {prog} --tree [DIR] [--max-lines N] [--max-tokens N]")
        else:
            p = Path(a).expanduser()
            if default_dir is not None and not p.is_absolute():
                p = default_dir / p
            if not p.is_dir():
                raise SystemExit(f"{prog}: directory not found: {a}")
            target_dir = p
            i += 1
    return build_repo_tree(root_dir=target_dir, max_lines=max_lines, max_tokens=max_tokens)


def cmd_tree(argv: list[str]) -> int:
    sys.stdout.write(_tree_from_args(argv))
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    prog = prog_name()
    if "-h" in args or "--help" in args:
        sys.stdout.write(usage_text())
        return 0
    if "-V" in args or "--version" in args:
        sys.stdout.write(f"{prog} {VERSION}\n")
        return 0
    if "--config" in args:
        return cmd_show_config()
    if "--init-config" in args:
        force = "--force" in args
        return cmd_init_config(force=force)
    if "--init-start" in args:
        force = "--force" in args
        return cmd_init_start(force=force)
    if "--agents" in args or "--agents-md" in args:
        sys.stdout.write(agents_markdown(prog) + "\n")
        return 0
    if args and args[0] == "--rules":
        return cmd_rules(args[1:])
    if not args:
        if not sys.stdin.isatty():
            session = resolve_initial_session(ensure_base())
            return cmd_normal(f"{session}/1", sys.stdin.read())
        sys.stderr.write(usage_text())
        return 2

    if args[0] in ("--list", "-l"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --list [session]")
        return cmd_list(args[1] if len(args) == 2 else None)

    if args[0] == "--show":
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --show [session/step]")
        return cmd_show(args[1] if len(args) == 2 else None)

    if args[0] in ("--retry", "--rerun"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --retry [session/step]")
        return cmd_retry(args[1] if len(args) == 2 else None)

    if args[0] == "--check-update":
        if len(args) != 1:
            raise SystemExit(f"{prog}: usage: {prog} --check-update")
        return cmd_check_update()

    if args[0] in ("--update", "--self-update"):
        force = "--force" in args[1:]
        rest = [a for a in args[1:] if a != "--force"]
        if rest:
            raise SystemExit(f"{prog}: usage: {prog} --update [--force]")
        return cmd_update(force=force)

    if args[0] == "--clean":
        return cmd_clean(args[1:])

    if args[0] == "--tree":
        return cmd_tree(args[1:])

    if args[0] == "--start":
        return cmd_start(args[1:])

    if args[0] == "--fix":
        if len(args) != 2:
            raise SystemExit(f"{prog}: usage: {prog} --fix <session>/<target>")
        return cmd_fix(args[1], sys.stdin.read())

    if len(args) != 1 or args[0].startswith("-"):
        raise SystemExit(
            f"{prog}: usage: {prog} [<session>/<step>] (or --fix / --retry / --list / --show / --clean / --tree / --start / --init-start / --config / --agents / --rules / --update / --version / --help)"
        )
    return cmd_normal(args[0], sys.stdin.read())


if __name__ == "__main__":
    raise SystemExit(main())
