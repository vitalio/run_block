def rules_dir_path() -> Path:
    env_dir = os.environ.get("RUN_BLOCK_RULES_DIR")
    if env_dir:
        return Path(env_dir).expanduser()
    return config_file_path().parent / "rules"


def _discover_user_rules() -> dict[str, Path]:
    rdir = rules_dir_path()
    if not rdir.is_dir():
        return {}
    out: dict[str, Path] = {}
    try:
        for p in sorted(rdir.glob("*.md")):
            if p.is_file():
                out[p.stem.lower()] = p
    except OSError:
        pass
    return out


def rules_markdown(topics: list[str] | None = None) -> str:
    prog = prog_name()
    user_rules = _discover_user_rules()
    raw_topics = [t.strip().lower() for t in (topics or []) if t.strip()]
    if not raw_topics:
        raw_topics = ["workflow"]

    expanded: list[str] = []
    for t in raw_topics:
        if t == "all":
            for k in BUILTIN_RULES:
                if k not in expanded:
                    expanded.append(k)
            for k in user_rules:
                if k not in expanded:
                    expanded.append(k)
        else:
            if t not in expanded:
                expanded.append(t)

    blocks: list[str] = []
    for t in expanded:
        if t in user_rules:
            body = user_rules[t].read_text(encoding="utf-8", errors="replace").strip()
            if body:
                blocks.append(body)
        elif t in BUILTIN_RULES:
            blocks.append("\n".join(BUILTIN_RULES[t][1]))
        else:
            avail = sorted(set(BUILTIN_RULES.keys()) | set(user_rules.keys())) + ["all"]
            raise SystemExit(
                f"{prog}: unknown rule topic {t!r} (available: {', '.join(avail)})"
            )

    hdr = f"## Agent Engineering Rules ({', '.join(expanded)})"
    return hdr + "\n\n" + "\n\n".join(blocks)


def cmd_rules(argv: list[str]) -> int:
    prog = prog_name()
    if any(a in ("--list", "-l") for a in argv):
        if len(argv) > 1:
            raise SystemExit(f"{prog}: usage: {prog} --rules [TOPIC ... | all | --list]")
        user_rules = _discover_user_rules()
        rdir = rules_dir_path()
        sys.stdout.write("Built-in rule topics:\n")
        for k, (desc, _) in BUILTIN_RULES.items():
            override = " (overridden by user file)" if k in user_rules else ""
            sys.stdout.write(f"  {k:<12}  {desc}{override}\n")
        sys.stdout.write("  all           Include all built-in and custom rule topics\n")
        custom_only = {k: p for k, p in user_rules.items() if k not in BUILTIN_RULES}
        sys.stdout.write(f"\nCustom rule files ({rdir}):\n")
        if custom_only:
            for k, p in custom_only.items():
                sys.stdout.write(f"  {k:<12}  {p}\n")
        else:
            sys.stdout.write("  (none — add <topic>.md files to this directory to define custom rules)\n")
        return 0
    for a in argv:
        if a.startswith("-"):
            raise SystemExit(f"{prog}: usage: {prog} --rules [TOPIC ... | all | --list]")
    sys.stdout.write(rules_markdown(argv) + "\n")
    return 0


def _git_toplevel_or_cwd() -> Path:
    try:
        r = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
            check=False,
        )
        if r.returncode == 0 and r.stdout.strip():
            top = Path(r.stdout.strip())
            if top.is_dir():
                return top.resolve()
    except Exception:
        pass
    return Path.cwd().resolve()


def _session_bundle_workdir(session_dir: Path | None) -> Path | None:
    if session_dir is None:
        return None
    bundle_file = session_dir / "0.txt"
    if not bundle_file.is_file():
        return None
    try:
        with bundle_file.open(encoding="utf-8", errors="replace") as f:
            for _ in range(10):
                line = f.readline()
                if not line or line.startswith("====="):
                    break
                if line.startswith("Workdir:"):
                    raw = line.split(":", 1)[1].strip()
                    if raw:
                        p = Path(raw)
                        if p.is_dir():
                            return p.resolve()
    except OSError:
        pass
    return None


def get_work_dir(session_dir: Path | None = None) -> Path:
    val, _ = get_setting("work_dir")
    if val.lower() == "cwd":
        return Path.cwd()
    if val.lower() != "auto":
        return Path(val).expanduser()
    base_root = _git_toplevel_or_cwd()
    start_file, spec_dir = find_start_file(base_root)
    if start_file is not None:
        return spec_dir
    sess_wdir = _session_bundle_workdir(session_dir)
    if sess_wdir is not None and (sess_wdir == base_root or base_root in sess_wdir.parents):
        return sess_wdir
    return base_root


def clipboard_mode() -> str:
    val, _ = get_setting("clipboard")
    if val in ("never", "off", "0", "false", "no"):
        return "never"
    if val in ("auto", "always"):
        return "auto"
    return "prompt"


def no_clipboard() -> bool:
    return clipboard_mode() == "never"


def in_run_block() -> bool:
    return os.environ.get("IN_RUN_BLOCK") == "1"


# --- Detailed pre-execution block plan and safety scanner ---
RISK_RULES: list[tuple[str, str, re.Pattern[str]]] = [
    (
        "git-destructive",
        "destructive Git operation",
        re.compile(
            r"\bgit\s+(?:reset\s+--hard|clean\s+-[A-Za-z]*f|push\s+[^\n]*(?:--force|-f\b|--delete)|branch\s+-D\b|tag\s+-d\b|checkout\s+--\s+\.|restore\s+\.|rebase\b|filter-branch\b)"
        ),
    ),
    (
        "external-write",
        "network or remote repository write",
        re.compile(
            r"(?:\bgit\s+push\b|\b(?:curl|wget)\b[^\n]*(?:-X\s*(?:POST|PUT|DELETE|PATCH)\b|--data\b|--form\b|\s-d\s|\s-F\s)|\b(?:scp|rsync)\s)"
        ),
    ),
    (
        "fs-destructive",
        "recursive or destructive file deletion/overwrite",
        re.compile(
            r"(?:\brm\s+-[A-Za-z]*(?:r|f)[A-Za-z]*\b|\bshutil\.rmtree\s*\(|\bos\.(?:remove|unlink)\s*\(|\bdd\s+[^\n]*\bof=|\b(?:mkfs|shred|fdisk)\b|>\s*(?:/etc/|~/.ssh/|\$HOME/\.ssh/))"
        ),
    ),
    (
        "privilege-system",
        "privilege escalation or system modification",
        re.compile(
            r"(?:\b(?:sudo|doas|pkexec|chown|systemctl|service|killall|pkill)\b|\bkill\s+-9\b|\bchmod\s+[0-7]*777\b|\b(?:apt|apt-get|yum|dnf|pacman|brew)\s+(?:install|remove|purge)\b|\bpip3?\s+install\b|\bnpm\s+install\s+-g\b)"
        ),
    ),
    (
        "secrets-exposure",
        "shell trace or credential file access",
        re.compile(
            r"(?:\bset\s+-[A-Za-z]*x\b|\bbash\s+-[A-Za-z]*x\b|\.ssh/id_[A-Za-z0-9_]+(?!\.pub)\b|\.netrc\b|\.aws/credentials\b)"
        ),
    ),
    (
        "remote-exec",
        "piping remote content into a shell or eval",
        re.compile(
            r"(?:\b(?:curl|wget)\b[^\n]*\|\s*(?:sudo\s+)?(?:sh|bash|zsh|python3?)\b|\beval\s+)"
        ),
    ),
]


def get_active_risk_rules() -> list[tuple[str, str, re.Pattern[str]]]:
    cfg = parse_config_file()
    raw_dis, _ = get_setting("safety_disable")
    disabled: set[str] = {
        x.strip().lower()
        for x in re.split(r"[,\s]+", raw_dis)
        if x.strip()
    }
    custom_map: dict[str, str] = {}
    for k, v in cfg.items():
        if k.startswith("safety_rule."):
            cat = k[len("safety_rule."):].strip().lower()
            if not cat:
                continue
            if v.strip().lower() in ("off", "none", "false", "0", "disable", "disabled"):
                disabled.add(cat)
            elif v.strip():
                custom_map[cat] = v.strip()
    env_rules = os.environ.get("RUN_BLOCK_SAFETY_RULES", "").strip()
    if env_rules:
        for item in env_rules.split(";"):
            part = item.strip()
            if not part:
                continue
            sep = "=" if "=" in part and (":" not in part or part.index("=") < part.index(":")) else (":" if ":" in part else "")
            if not sep:
                continue
            cat_raw, pat_raw = part.split(sep, 1)
            cat = cat_raw.strip().lower()
            pat_str = pat_raw.strip()
            if not cat:
                continue
            if pat_str.lower() in ("off", "none", "false", "0", "disable", "disabled"):
                disabled.add(cat)
                custom_map.pop(cat, None)
            elif pat_str:
                custom_map[cat] = pat_str
                disabled.discard(cat)

    active: list[tuple[str, str, re.Pattern[str]]] = []
    seen_cats: set[str] = set()
    for cat, desc, pat in RISK_RULES:
        if cat in disabled:
            continue
        if cat in custom_map:
            try:
                active.append((cat, desc, re.compile(custom_map[cat])))
                seen_cats.add(cat)
                continue
            except re.error:
                pass
        active.append((cat, desc, pat))
        seen_cats.add(cat)

    for cat, pat_str in custom_map.items():
        if cat in disabled or cat in seen_cats:
            continue
        try:
            active.append((cat, f"custom safety rule ({cat})", re.compile(pat_str)))
            seen_cats.add(cat)
        except re.error:
            pass
    return active

PY_HEREDOC_START_RE = re.compile(r"python3?\s+-[^\n]*<<-?['\"]?([A-Za-z0-9_]+)['\"]?")


def _add_unique(items: list[str], val: str, limit: int = 12) -> None:
    clean = val.strip()
    if clean and clean not in items and len(items) < limit:
        items.append(clean)


def _extract_py_path_expr(node: ast.AST, var_map: dict[str, str]) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.Name) and node.id in var_map:
        return var_map[node.id]
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
        left = _extract_py_path_expr(node.left, var_map)
        right = _extract_py_path_expr(node.right, var_map)
        if right:
            return f"{left}/{right}" if left and not left.startswith("<") else right
    if isinstance(node, ast.Call):
        if isinstance(node.func, ast.Name) and node.func.id == "Path" and node.args:
            return _extract_py_path_expr(node.args[0], var_map)
        if isinstance(node.func, ast.Attribute) and node.func.attr == "home":
            return "~"
    return None


def _analyze_python_ast(
    py_code: str,
    writes: list[str],
    reads: list[str],
    execs: list[str],
    py_risks: list[dict[str, object]],
    start_line_offset: int = 0,
) -> None:
    try:
        tree = ast.parse(py_code)
    except Exception:
        return
    var_map: dict[str, str] = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            p = _extract_py_path_expr(node.value, var_map)
            if p:
                var_map[node.targets[0].id] = p
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        unparsed = ast.unparse(node) if hasattr(ast, "unparse") else ""
        if isinstance(node.func, ast.Attribute):
            attr = node.func.attr
            owner = _extract_py_path_expr(node.func.value, var_map)
            mod_name = node.func.value.id if isinstance(node.func.value, ast.Name) else ""
            if attr in ("write_text", "write_bytes"):
                _add_unique(writes, owner or "file (python)")
            elif attr in ("read_text", "read_bytes") and owner:
                _add_unique(reads, owner)
            elif attr == "parse" and mod_name == "ast":
                _add_unique(execs, "ast.parse")
            elif mod_name in ("shutil", "os") and attr in ("copy", "copy2", "move", "replace") and len(node.args) >= 2:
                dst = _extract_py_path_expr(node.args[-1], var_map)
                _add_unique(writes, dst or f"{mod_name}.{attr}")
            elif (mod_name == "shutil" and attr == "rmtree") or (mod_name == "os" and attr in ("remove", "unlink", "system")) or attr == "unlink":
                target = _extract_py_path_expr(node.args[0], var_map) if node.args else owner
                _add_unique(writes, f"{attr}({target or '...'})")
                if mod_name in ("shutil", "os"):
                    py_risks.append({
                        "line": start_line_offset + getattr(node, "lineno", 1),
                        "category": "fs-destructive",
                        "description": "destructive Python call",
                        "snippet": unparsed or f"{mod_name}.{attr}(...)",
                    })
        elif isinstance(node.func, ast.Name) and node.func.id == "open" and len(node.args) >= 2:
            mode_node = node.args[1]
            if isinstance(mode_node, ast.Constant) and isinstance(mode_node.value, str):
                if any(m in mode_node.value for m in ("w", "a", "x")):
                    target = _extract_py_path_expr(node.args[0], var_map)
                    _add_unique(writes, target or "open(..., 'w')")


def summarize_script_actions(script_text: str, work_dir: Path | None = None) -> dict[str, object]:
    wdir = work_dir if work_dir is not None else get_work_dir()
    lines = script_text.splitlines()
    non_empty = [l for l in lines if l.strip()]
    writes: list[str] = []
    reads: list[str] = []
    git_cmds: list[str] = []
    exec_cmds: list[str] = []
    cd_dirs: list[str] = []
    operations: list[tuple[str, str]] = []
    py_blocks = 0
    py_eof: str | None = None
    py_buf: list[str] = []
    py_start = 0

    for idx, raw in enumerate(lines, start=1):
        s = raw.strip()
        if py_eof is not None:
            if s == py_eof:
                pw: list[str] = []
                pr: list[str] = []
                pe: list[str] = []
                _analyze_python_ast("\n".join(py_buf), pw, pr, pe, [], py_start)
                for x in pw:
                    _add_unique(writes, x)
                for x in pr:
                    _add_unique(reads, x)
                for x in pe:
                    _add_unique(exec_cmds, x)
                parts = []
                if pw:
                    parts.append("writes: " + ", ".join(pw))
                if pr:
                    parts.append("reads: " + ", ".join(pr))
                if pe:
                    parts.append("calls: " + ", ".join(pe))
                desc = f"{len(py_buf)} lines" + (f" — {'; '.join(parts)}" if parts else "")
                operations.append((f"Python #{py_blocks}", desc))
                py_eof = None
                py_buf = []
            else:
                py_buf.append(raw)
            continue
        if not s or s.startswith("#"):
            continue
        m_py = PY_HEREDOC_START_RE.search(s)
        if m_py:
            py_blocks += 1
            py_eof = m_py.group(1)
            py_buf = []
            py_start = idx
            continue
        if re.match(r"^(?:echo|printf)\b", s) and ">" not in s:
            continue
        if re.match(r"^set\s+[+-][A-Za-z]", s):
            continue
        m_cd = re.match(r"^cd\s+(.+)$", s)
        if m_cd:
            raw_target = m_cd.group(1).strip().strip('"').strip("'")
            try:
                resolved_cd = (wdir / os.path.expanduser(raw_target)).resolve()
                if resolved_cd != wdir.resolve():
                    _add_unique(cd_dirs, m_cd.group(1).strip())
            except Exception:
                _add_unique(cd_dirs, m_cd.group(1).strip())
            continue
        if re.match(r"^git\s+", s):
            _add_unique(git_cmds, s)
            operations.append(("Git", s))
            continue
        if re.match(r"^(?:rm|cp|mv|mkdir|chmod|touch)\s+", s):
            _add_unique(writes, s)
            operations.append(("Write/FS", s))
            continue
        if re.match(r"^(?:cat|grep|ls|head|tail|find|which|command\s+-v|wc|stat|file)\s+", s):
            _add_unique(reads, s)
            operations.append(("Read", s))
            continue
        operations.append(("Exec", s))
        _add_unique(exec_cmds, s)

    rows: list[tuple[str, str]] = []
    for label, bucket in (
        ("Write/FS", writes),
        ("Read", reads),
        ("Git", git_cmds),
        ("Exec", exec_cmds),
    ):
        if bucket:
            rows.append((label, ", ".join(bucket)))
    sh_tag = "pwsh" if _is_powershell() else "bash"
    meta = f"{len(non_empty)} line{'s' if len(non_empty) != 1 else ''}"
    if py_blocks:
        meta += f", {sh_tag} + {py_blocks} python block{'s' if py_blocks != 1 else ''}"
    else:
        meta += f", {sh_tag}"
    return {
        "meta": meta,
        "rows": rows,
        "operations": operations,
        "cd_dirs": cd_dirs,
        "work_dir": str(wdir),
    }


def scan_script_risks(script_text: str) -> list[dict[str, object]]:
    active_rules = get_active_risk_rules()
    active_cats = {cat for cat, _, _ in active_rules}
    findings: list[dict[str, object]] = []
    py_eof_token: str | None = None
    py_buf: list[str] = []
    py_start = 0
    for idx, raw_line in enumerate(script_text.splitlines(), start=1):
        stripped = raw_line.strip()
        if py_eof_token is not None:
            if stripped == py_eof_token:
                py_f: list[dict[str, object]] = []
                _analyze_python_ast("\n".join(py_buf), [], [], [], py_f, py_start)
                for pf in py_f:
                    if str(pf.get("category")) in active_cats:
                        findings.append(pf)
                py_eof_token = None
                py_buf = []
            else:
                py_buf.append(raw_line)
            continue

        if not stripped or stripped.startswith("#"):
            continue
        m_py = PY_HEREDOC_START_RE.search(stripped)
        if m_py:
            py_eof_token = m_py.group(1)
            py_buf = []
            py_start = idx
            continue
        for category, desc, pat in active_rules:
            if pat.search(stripped):
                clean_snip = re.sub(r"\s+", " ", stripped).replace("│", "|")
                findings.append(
                    {
                        "line": idx,
                        "category": category,
                        "description": desc,
                        "snippet": clean_snip,
                    }
                )
                break
    deduped: list[dict[str, object]] = []
    seen_pairs: set[tuple[str, str]] = set()
    for f in findings:
        pair = (str(f["category"]), str(f["snippet"]))
        if pair not in seen_pairs:
            seen_pairs.add(pair)
            deduped.append(f)
    return deduped


def open_tty():
    tty_in_name = "CONIN$" if os.name == "nt" else "/dev/tty"
    tty_out_name = "CONOUT$" if os.name == "nt" else "/dev/tty"
    return (
        open(tty_out_name, "w", encoding="utf-8", errors="replace"),
        open(tty_in_name, "r", encoding="utf-8", errors="replace"),
    )


def flush_tty_input(tty_r) -> None:
    if HAS_PTY and termios is not None:
        try:
            termios.tcflush(tty_r.fileno(), termios.TCIFLUSH)
        except Exception:
            pass


def read_clipboard_key(tty_r) -> str:
    """Wait for a single key: returns 'copy', 'skip', or 'view'."""
    flush_tty_input(tty_r)
    if not HAS_PTY or termios is None or tty is None:
        ans = tty_r.readline().strip().lower()
        if ans in ("v", "view", "e", "edit"):
            return "view"
        return "skip" if ans in ("n", "no", "esc", "\x1b") else "copy"
    try:
        fd = tty_r.fileno()
        old_attrs = termios.tcgetattr(fd)
    except Exception:
        ans = tty_r.readline().strip().lower()
        return "view" if ans in ("v", "view", "e", "edit") else ("skip" if ans in ("n", "no", "esc", "\x1b") else "copy")
    try:
        tty.setraw(fd, termios.TCSANOW)
        while True:
            ch = os.read(fd, 1)
            if not ch:
                return "skip"
            if ch in (b"v", b"V", b"e", b"E"):
                return "view"
            if ch in (b"\r", b"\n", b"y", b"Y"):
                return "copy"
            if ch in (b"n", b"N", b"q", b"Q", b"\x03", b"\x04"):
                return "skip"
            if ch == b"\x1b":
                # Distinguish standalone Esc from multi-byte escape sequences (like arrow keys)
                rlist, _, _ = select.select([fd], [], [], 0.05)
                if rlist:
                    os.read(fd, 32)
                    continue
                return "skip"
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        except Exception:
            pass


def _wrap_labeled_items(items: list[tuple[str, str]], max_width: int, indent: str = "  ") -> list[str]:
    if not items:
        return []
    tag_w = max(len(f"[{k}]") for k, _ in items)
    out: list[str] = []
    for k, v in items:
        tag = f"[{k}]".ljust(tag_w)
        prefix = f"{indent}{tag}  "
        sub_indent = " " * len(prefix)
        avail = max(24, max_width - len(prefix))
        wrapped = textwrap.wrap(v, width=avail, break_long_words=True, break_on_hyphens=False) or [v]
        out.append(prefix + wrapped[0])
        for cont in wrapped[1:]:
            out.append(sub_indent + cont)
    return out


def format_safety_box(
    label: str,
    findings: list[dict[str, object]],
    default_yes: bool = False,
    summary: dict[str, object] | None = None,
) -> tuple[str, int, int]:
    meta_str = str(summary.get('meta', '')) if summary else ''
    if findings:
        plural = "s" if len(findings) != 1 else ""
        hdr_detail = f"{meta_str} | {len(findings)} safety warning{plural}" if meta_str else f"{len(findings)} safety warning{plural}"
        title = f" [{label}] [!] BLOCK PLAN ({hdr_detail}) "
    elif meta_str:
        title = f" [{label}] BLOCK PLAN ({meta_str}) "
    else:
        title = f" [{label}] BLOCK PLAN "
    prompt_suffix = "[Y/n/v(iew)]:" if default_yes else "[y/n/v(iew)]:"
    prompt_line = f"-> Execute this block? {prompt_suffix}"
    term_cols = shutil.get_terminal_size((100, 24)).columns
    max_row_len = max(64, term_cols - 6)

    content_lines: list[str] = []
    if summary:
        wdir = str(summary.get("work_dir") or "")
        cd_dirs = list(summary.get("cd_dirs") or [])
        if wdir:
            wline = f"Workdir: {wdir}" + (f"  (cd -> {', '.join(cd_dirs)})" if cd_dirs else "")
            content_lines.extend(textwrap.wrap(wline, width=max_row_len) or [wline])
        ops = list(summary.get("operations") or [])
        if ops:
            if content_lines:
                content_lines.append("")
            content_lines.append("Operations:")
            content_lines.extend(_wrap_labeled_items(ops, max_row_len, indent="  "))

    if findings:
        if content_lines:
            content_lines.append("")
            content_lines.append("Safety warnings:")
            w_indent = "  "
        else:
            w_indent = ""
        warn_items = [(str(f["category"]), str(f["snippet"])) for f in findings]
        content_lines.extend(_wrap_labeled_items(warn_items, max_row_len, indent=w_indent))

    inner_width = max(
        display_width(title),
        display_width(prompt_line),
        *(display_width(b) for b in content_lines),
    )
    dashes = max(1, inner_width + 2 - display_width(title) - 1)
    top = f"┌─{title}{'─' * dashes}┐"
    bottom = f"└─{'─' * inner_width}─┘"
    rows = [pad_box_line(b, inner_width) for b in content_lines]
    if content_lines:
        rows.append(pad_box_line("", inner_width))
    rows.append(pad_box_line(prompt_line, inner_width))
    box = "\n".join([top, *rows, bottom])
    cursor_col_offset = 2 + display_width(prompt_line)
    return box, inner_width, cursor_col_offset


def format_info_box(title: str, content_lines: list[str]) -> str:
    hdr = title if title.startswith(" ") else f" {title} "
    inner_width = max(
        display_width(hdr),
        *(display_width(b) for b in content_lines),
    )
    dashes = max(1, inner_width + 2 - display_width(hdr) - 1)
    top = f"┌─{hdr}{'─' * dashes}┐"
    bottom = f"└─{'─' * inner_width}─┘"
    rows = [pad_box_line(b, inner_width) for b in content_lines] or [pad_box_line("", inner_width)]
    return "\n".join([top, *rows, bottom])


